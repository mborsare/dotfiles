#!/usr/bin/env bash
set -Eeuo pipefail

# ─────────────────────────────────────────────────────────────
# Morningbrief
# oldbook does the work.
# Finished assets go to ~/cloud, which is a symlink to the mount.
#
# Current mode:
#   daily cartoon grab from ~/Documents/Will-broadcast
# ─────────────────────────────────────────────────────────────

WILL="$HOME/Documents/Will-broadcast"
CLOUD="$HOME/cloud"

TODAY="$(date +%F)"
OUTROOT="$CLOUD/morningbrief"
OUT="$OUTROOT/$TODAY"
LATEST="$OUTROOT/latest"
LOGROOT="$OUTROOT/logs"
LOG="$LOGROOT/morningbrief-$TODAY.log"

CARTOON_OUT="$OUT/cartoon-$TODAY.jpg"

# ─────────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────────

die() {
  echo "morningbrief: ERROR: $*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

on_error() {
  local line=$1
  local code=$2
  echo "morningbrief: ERROR on line $line, exit $code" >&2
}

trap 'on_error "$LINENO" "$?"' ERR

# ─────────────────────────────────────────────────────────────
# Checks
# ─────────────────────────────────────────────────────────────

need magick
need ffmpeg
need ffprobe
need shuf
need awk
need cp
need rm
need mkdir
need find
need tee
need hostname

[[ -e "$CLOUD" ]] || die "$CLOUD does not exist"
[[ -d "$CLOUD" ]] || die "$CLOUD is not a directory"
[[ -w "$CLOUD" ]] || die "$CLOUD is not writable"
[[ -d "$WILL" ]] || die "missing Will-broadcast dir: $WILL"

mkdir -p "$OUT" "$LOGROOT"

# Send all output to terminal AND log file.
exec > >(tee -a "$LOG") 2>&1

echo "────────────────────────────────────────"
echo "morningbrief start: $(date)"
echo "host: $(hostname)"
echo "user: $USER"
echo "cloud: $CLOUD"
echo "out: $OUT"
echo "log: $LOG"
echo "source dir: $WILL"
echo "────────────────────────────────────────"

# ─────────────────────────────────────────────────────────────
# Grab daily cartoon still
# ─────────────────────────────────────────────────────────────

echo "finding random cartoon/media..."

SRC="$(
  find "$WILL" -type f \( \
    -iname '*.jpg'  -o \
    -iname '*.jpeg' -o \
    -iname '*.png'  -o \
    -iname '*.webp' -o \
    -iname '*.gif'  -o \
    -iname '*.mp4'  -o \
    -iname '*.mov'  -o \
    -iname '*.mkv'  -o \
    -iname '*.webm' -o \
    -iname '*.m4v'  -o \
    -iname '*.avi' \
  \) | shuf -n 1
)"

[[ -n "$SRC" ]] || die "no media found in $WILL"

echo "source: $SRC"

case "${SRC,,}" in
  *.jpg|*.jpeg|*.png|*.webp|*.gif)
    magick "$SRC" \
      -auto-orient \
      -resize '1600x1600>' \
      "$CARTOON_OUT"
    ;;

  *)
    DUR="$(
      ffprobe -v error \
        -show_entries format=duration \
        -of default=noprint_wrappers=1:nokey=1 \
        "$SRC" 2>/dev/null || echo 5
    )"

    SS="$(
      awk -v d="$DUR" 'BEGIN {
        srand();
        if (d <= 2) printf "0";
        else printf "%.2f", (d * 0.10) + rand() * (d * 0.80);
      }'
    )"

    echo "video duration: $DUR"
    echo "grab second: $SS"

    ffmpeg -hide_banner -loglevel error -y \
      -ss "$SS" \
      -i "$SRC" \
      -frames:v 1 \
      -q:v 2 \
      "$CARTOON_OUT"
    ;;
esac

[[ -s "$CARTOON_OUT" ]] || die "cartoon grab missing or empty: $CARTOON_OUT"

printf '%s\n' "$SRC" > "$OUT/cartoon-source-$TODAY.txt"

echo "cartoon saved: $CARTOON_OUT"

# ─────────────────────────────────────────────────────────────
# Latest folder
# ─────────────────────────────────────────────────────────────

echo "updating latest..."

rm -rf "$LATEST"
mkdir -p "$LATEST"
cp -f "$OUT"/* "$LATEST"/
cp -f "$LOG" "$LATEST/latest.log" 2>/dev/null || true

# ─────────────────────────────────────────────────────────────
# Done
# ─────────────────────────────────────────────────────────────

echo "────────────────────────────────────────"
echo "morningbrief done: $(date)"
echo "saved:        $OUT"
echo "latest:       $LATEST"
echo "cartoon:      $CARTOON_OUT"
echo "source:       $SRC"
echo "log:          $LOG"
echo "────────────────────────────────────────"
