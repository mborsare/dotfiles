#!/usr/bin/env bash
set -euo pipefail

# --- Configuration ---
PORT="8090"
ROOT_HLS_DIR="/tmp/broadcast-hls"
FFMPEG="ffmpeg"
LOGO_PATH="$HOME/Documents/Prime/logotype.png"

CLOCK_FILE="/tmp/broadcast-clocks-$$.txt"
WEATHER_FILE="/tmp/broadcast-weather-$$.txt"
NQ_NOW_FILE="/tmp/broadcast-nq-now-$$.txt"
NQ_TICKER_FILE="/tmp/broadcast-nq-ticker-$$.txt"
HEADLINE_FILE="/tmp/broadcast-headlines-$$.txt"

NQ_TICKER_URL="https://weather.mborsare.workers.dev/prime/weather/NQ"
WEATHER_ZIPS=("02130" "28803" "35242" "37922")

OUTPUT_FPS="24"
VIDEO_BITRATE="2200k"
VIDEO_MAXRATE="2600k"
VIDEO_BUFSIZE="5200k"
AUDIO_BITRATE="96k"
HLS_TIME="2"
HLS_LIST_SIZE="6"

CHANNELS=(
  "Prime|Prime|$HOME/Documents/Primetv|1280:720"
)

STOP_FILE="/tmp/broadcast-stop-$$"

cleanup() {
  touch "$STOP_FILE"
  echo -e "\n\033[0;31m[!] Atomic Cleanup Initiated...\033[0m"

  lsof -ti :"$PORT" | xargs kill -9 2>/dev/null || true

  local pids
  pids="$(jobs -pr || true)"
  if [[ -n "$pids" ]]; then
    kill $pids 2>/dev/null || true
  fi

  pkill -9 -f "$ROOT_HLS_DIR" 2>/dev/null || true

  rm -f "$STOP_FILE"
  rm -f "$CLOCK_FILE"
  rm -f "$WEATHER_FILE"
  rm -f "$NQ_NOW_FILE"
  rm -f "$NQ_TICKER_FILE"
  rm -f "$HEADLINE_FILE"

  echo "[+] Broadcast stopped."
  exit 0
}
trap cleanup EXIT INT TERM

start_server() {
  echo "[*] Starting Web Server on port $PORT..."
  python3 -m http.server "$PORT" --directory "$ROOT_HLS_DIR" >/tmp/broadcast-server.log 2>&1 &
}

start_clock_file() {
  (
    while [[ ! -f "$STOP_FILE" ]]; do
      local nq_now
      nq_now="$(cat "$NQ_NOW_FILE" 2>/dev/null || printf "-----")"

      printf "Now is %s  //  NQ %s\n" \
        "$(date '+%H:%M:%S')" \
        "$nq_now" \
        > "$CLOCK_FILE"

      sleep 1
    done
  ) &
}

start_weather_file() {
  (
    while [[ ! -f "$STOP_FILE" ]]; do
      local parts=()
      local zip
      local temp
      local line

      for zip in "${WEATHER_ZIPS[@]}"; do
        temp="$(curl -sf --max-time 4 "https://wttr.in/${zip}?format=%t&u" 2>/dev/null | tr -d '+')"

        if [[ -z "$temp" ]]; then
          temp="--°F"
        fi

        parts+=("${zip} ${temp}")
      done

      line="${parts[0]}"
      for ((i = 1; i < ${#parts[@]}; i++)); do
        line+="  /  ${parts[$i]}"
      done

      printf "%s\n" "$line" > "$WEATHER_FILE"
      sleep 300
    done
  ) &
}

start_nq_ticker_file() {
  (
    while [[ ! -f "$STOP_FILE" ]]; do
      curl -sf --max-time 5 "$NQ_TICKER_URL" \
        | python3 -c '
import json
import math
import sys
from datetime import datetime, timedelta
from zoneinfo import ZoneInfo

nq_now_file = "'"$NQ_NOW_FILE"'"

try:
    d = json.load(sys.stdin)

    prices = d.get("priceSeries", [])
    ranges = d.get("rangeSeries", [])
    as_of_raw = d.get("asOf")

    if not prices or not ranges or not as_of_raw:
        raise ValueError("missing data")

    as_of = datetime.fromisoformat(as_of_raw.replace("Z", "+00:00"))
    et = ZoneInfo("America/New_York")

    vals = [float(x) for x in ranges]
    mean = sum(vals) / len(vals)
    variance = sum((x - mean) ** 2 for x in vals) / len(vals)
    std = math.sqrt(variance)

    latest = prices[-1]
    latest_mid = (float(latest["hi"]) + float(latest["lo"])) / 2

    with open(nq_now_file, "w") as f:
        f.write(str(int(latest_mid)))

    items = []
    n = min(len(prices), len(ranges), 42)

    for offset in range(1, n):
        i = len(prices) - 1 - offset
        ts = (as_of - timedelta(minutes=offset)).astimezone(et)

        p = prices[i]
        mid = (float(p["hi"]) + float(p["lo"])) / 2
        rng = float(ranges[i])

        stamp = ts.strftime("%H:%M")
        entry = f"{stamp} {int(mid)} {int(rng)}"

        if rng > mean + 2 * std:
            entry = f"*** {entry} ***"
        elif rng > mean + std:
            entry = f"* {entry} *"

        items.append(entry)

    print("      ".join(items))

except Exception:
    with open(nq_now_file, "w") as f:
        f.write("-----")
    print("NQ TAPE UNAVAILABLE")
' > "$NQ_TICKER_FILE" || {
          printf -- "-----\n" > "$NQ_NOW_FILE"
          echo "NQ TAPE UNAVAILABLE" > "$NQ_TICKER_FILE"
        }

      sleep 60
    done
  ) &
}

fetch_headline() {
  local feed="https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml"
  local encoded

  encoded="$(python3 -c 'import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))' "$feed")"

  curl -sf --max-time 5 "https://api.rss2json.com/v1/api.json?rss_url=$encoded" \
    | python3 -c "
import json, sys, random
try:
    data = json.load(sys.stdin)
    items = data.get('items', [])[:10]
    if items:
        picks = [i['title'] for i in random.sample(items, min(5, len(items)))]
        print('   //   '.join(picks))
except:
    pass
" 2>/dev/null || true
}

start_headline_file() {
  (
    while [[ ! -f "$STOP_FILE" ]]; do
      local headline
      headline="$(fetch_headline | tr "'\\%[]=" "      ")"

      if [[ -z "$headline" ]]; then
        headline="PRIME BROADCAST"
      fi

      printf "%s\n" "$headline" > "$HEADLINE_FILE"
      echo -e "\033[0;33m[chyron]\033[0m $headline"

      sleep 600
    done
  ) &
}

write_channel_manifest() {
  local manifest="$ROOT_HLS_DIR/channels.json"

  python3 - "$manifest" "${CHANNELS[@]}" <<'PY'
import json
import sys

manifest = sys.argv[1]
channels = sys.argv[2:]

out = []

for i, raw in enumerate(channels):
    name, display_name, _media_dir, _size = raw.split("|", 3)

    out.append({
        "number": f"{i + 3:02d}",
        "name": display_name.upper(),
        "path": f"/{name}/index.m3u8"
    })

with open(manifest, "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2)
    f.write("\n")
PY
}

write_concat_playlist() {
  local media_dir="$1"
  local playlist_ffconcat="$2"

  python3 - "$media_dir" "$playlist_ffconcat" <<'PY'
import random
import sys
from pathlib import Path

media_dir = Path(sys.argv[1]).expanduser()
playlist = Path(sys.argv[2])

exts = {".mp4", ".mkv", ".mov"}
files = [
    p.resolve()
    for p in media_dir.rglob("*")
    if p.is_file() and p.suffix.lower() in exts
]

files.sort(key=lambda p: str(p).lower())
random.shuffle(files)

if not files:
    raise SystemExit(f"No media files found in {media_dir}")

def ffconcat_quote(path: Path) -> str:
    s = str(path)
    return "'" + s.replace("'", "'\\''") + "'"

with playlist.open("w", encoding="utf-8") as f:
    f.write("ffconcat version 1.0\n")
    for path in files:
        f.write(f"file {ffconcat_quote(path)}\n")
PY
}

build_video_filter() {
  local width="$1"
  local height="$2"
  local font_path="/System/Library/Fonts/Supplemental/Comic Sans MS.ttf"

  local v_filter
  v_filter="fps=$OUTPUT_FPS,"
  v_filter+="setsar=1,"
  v_filter+="scale=$width:$height:force_original_aspect_ratio=decrease:force_divisible_by=2,"
  v_filter+="pad=$width:$height:(ow-iw)/2:(oh-ih)/2,"
  v_filter+="setsar=1,format=yuv420p [main];"
  v_filter+="movie='$LOGO_PATH',scale=88:-1 [logo];"
  v_filter+="[main][logo] overlay=W-w-26:28 [combined];"

  v_filter+="[combined] drawtext="
  v_filter+="fontfile='$font_path':"
  v_filter+="textfile='$CLOCK_FILE':"
  v_filter+="reload=1:"
  v_filter+="x=26:"
  v_filter+="y=22:"
  v_filter+="fontsize=15:"
  v_filter+="fontcolor=0xF4E66A [clocked];"

  v_filter+="[clocked] drawtext="
  v_filter+="fontfile='$font_path':"
  v_filter+="textfile='$WEATHER_FILE':"
  v_filter+="reload=1:"
  v_filter+="x=26:"
  v_filter+="y=44:"
  v_filter+="fontsize=14:"
  v_filter+="fontcolor=white [weathered];"

  v_filter+="[weathered] drawtext="
  v_filter+="fontfile='$font_path':"
  v_filter+="textfile='$NQ_TICKER_FILE':"
  v_filter+="reload=1:"
  v_filter+="x=W-mod(t*54\\,W+tw):"
  v_filter+="y=H-68:"
  v_filter+="fontsize=17:"
  v_filter+="fontcolor=white [nqtape];"

  v_filter+="[nqtape] drawtext="
  v_filter+="fontfile='$font_path':"
  v_filter+="textfile='$HEADLINE_FILE':"
  v_filter+="reload=1:"
  v_filter+="x=W-mod(t*42\\,W+tw):"
  v_filter+="y=H-36:"
  v_filter+="fontsize=20:"
  v_filter+="fontcolor=0xF4E66A"

  printf "%s" "$v_filter"
}

start_channel() {
  local name="$1"
  local display_name="$2"
  local media_dir="$3"
  local size="$4"
  local width="${size%%:*}"
  local height="${size##*:}"
  local hls_dir="$ROOT_HLS_DIR/$name"
  local playlist_ffconcat="$hls_dir/files.ffconcat"
  local v_filter

  mkdir -p "$hls_dir"

  write_concat_playlist "$media_dir" "$playlist_ffconcat"
  v_filter="$(build_video_filter "$width" "$height")"

  echo -e "\033[0;34m[$display_name]\033[0m Starting always-on channel encoder..."

  (
    while [[ ! -f "$STOP_FILE" ]]; do
      "$FFMPEG" -nostdin -hide_banner -loglevel warning \
        -re \
        -stream_loop -1 \
        -fflags +genpts+discardcorrupt \
        -err_detect ignore_err \
        -f concat \
        -safe 0 \
        -i "$playlist_ffconcat" \
        -vf "$v_filter" \
        -c:v h264_videotoolbox \
        -profile:v main \
        -b:v "$VIDEO_BITRATE" \
        -maxrate "$VIDEO_MAXRATE" \
        -bufsize "$VIDEO_BUFSIZE" \
        -g "$((OUTPUT_FPS * HLS_TIME))" \
        -pix_fmt yuv420p \
        -af "aresample=async=1:first_pts=0" \
        -c:a aac \
        -b:a "$AUDIO_BITRATE" \
        -ar 44100 \
        -ac 2 \
        -f hls \
        -hls_time "$HLS_TIME" \
        -hls_list_size "$HLS_LIST_SIZE" \
        -hls_start_number_source epoch \
        -hls_flags delete_segments+omit_endlist+program_date_time+independent_segments \
        -hls_delete_threshold 30 \
        -hls_segment_filename "$hls_dir/seg_%d.ts" \
        "$hls_dir/index.m3u8"

      if [[ ! -f "$STOP_FILE" ]]; then
        echo -e "\033[0;31m[$display_name]\033[0m Encoder exited. Restarting in 2 seconds..."
        sleep 2
      fi
    done
  ) &
}

# --- Execution ---
pkill -9 -f "python3 -m http.server $PORT" 2>/dev/null || true
pkill -9 -f "$ROOT_HLS_DIR" 2>/dev/null || true

rm -rf "$ROOT_HLS_DIR"
mkdir -p "$ROOT_HLS_DIR"

rm -f "$STOP_FILE"
rm -f "$CLOCK_FILE"
rm -f "$WEATHER_FILE"
rm -f "$NQ_NOW_FILE"
rm -f "$NQ_TICKER_FILE"
rm -f "$HEADLINE_FILE"

printf "Now is --:--:--  //  NQ -----\n" > "$CLOCK_FILE"
printf "02130 --°F  /  28803 --°F  /  35242 --°F  /  37922 --°F\n" > "$WEATHER_FILE"
printf -- "-----\n" > "$NQ_NOW_FILE"
printf "NQ TAPE LOADING\n" > "$NQ_TICKER_FILE"
printf "PRIME BROADCAST\n" > "$HEADLINE_FILE"

write_channel_manifest

start_server
start_clock_file
start_weather_file
start_nq_ticker_file
start_headline_file

for channel in "${CHANNELS[@]}"; do
  IFS='|' read -r name display_name media_dir size <<< "$channel"
  start_channel "$name" "$display_name" "$media_dir" "$size"
done

echo "[*] Initializing streams..."

for channel in "${CHANNELS[@]}"; do
  IFS='|' read -r name _ _ _ <<< "$channel"
  until [[ -f "$ROOT_HLS_DIR/$name/index.m3u8" ]]; do
    sleep 0.5
  done
done

echo -e "\n\033[1;32m------------------------------------------------\033[0m"
echo -e "\033[1;32m   PRIME BROADCAST LIVE \033[0m"
echo -e "\033[1;32m------------------------------------------------\033[0m"

echo -e "\033[1mManifest:\033[0m http://localhost:$PORT/channels.json"
echo ""

for channel in "${CHANNELS[@]}"; do
  IFS='|' read -r name display_name _ _ <<< "$channel"
  echo -e "\033[1mChannel:\033[0m $display_name"
  echo "http://localhost:$PORT/$name/index.m3u8"
  echo ""
done

echo "Press Ctrl+C to stop."
wait
