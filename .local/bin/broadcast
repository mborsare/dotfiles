#!/usr/bin/env bash
set -euo pipefail

# Configuration
PORT="${PORT:-8090}"
BIND_ADDR="${BIND_ADDR:-127.0.0.1}"
ROOT_HLS_DIR="${ROOT_HLS_DIR:-$HOME/cloud/broadcast-hls}"
MEDIA="$HOME/Documents/Will-broadcast"
LOGO="${LOGO_PATH:-$HOME/Documents/Prime/logotype.png}"
SIZE="${DEFAULT_SIZE:-640:360}"
FPS="${OUTPUT_FPS:-24}"
QUOTE_URL="${QUOTE_BASE_URL:-https://weather.mborsare.workers.dev/prime/weather}"
REWIND_SECONDS="${REWIND_SECONDS:-10}"
FFMPEG="${FFMPEG:-ffmpeg}"
FFPROBE="${FFPROBE:-ffprobe}"
TITLE=""
SHOW_RUNTIME=0

# Arguments
media_set=0
while (( $# )); do
  case "$1" in
    --runtime) SHOW_RUNTIME=1; shift ;;
    --now-playing)
      if (( $# < 2 )); then echo '--now-playing requires a title' >&2; exit 2; fi
      TITLE="$2"; shift 2 ;;
    --help|-h)
      echo 'usage: broadcast-lite [MOVIE_OR_DIRECTORY] [--now-playing TITLE] [--runtime]'
      echo '  --runtime    Show VCR-style PLAY HH:MM:SS flag below the Prime logo (off by default)'
      exit 0 ;;
    --) shift; if (( $# == 1 && ! media_set )); then MEDIA="$1"; media_set=1; shift; else echo 'Expected one media path' >&2; exit 2; fi ;;
    -*) echo "Unknown option: $1" >&2; exit 2 ;;
    *) if (( media_set )); then echo 'Only one media path is allowed' >&2; exit 2; fi
       MEDIA="$1"; media_set=1; shift ;;
  esac
done
[[ -e "$MEDIA" ]] || { echo "No such media: $MEDIA" >&2; exit 1; }
for binary in "$FFMPEG" "$FFPROBE" python3 curl; do
  command -v "$binary" >/dev/null || { echo "Missing: $binary" >&2; exit 1; }
done

# Runtime Files
OUT="$ROOT_HLS_DIR/Prime"
WORK="$(mktemp -d /tmp/prime-lite.XXXXXXXX)"
QUOTE_FILE="$WORK/quote.txt"
TITLE_FILE="$WORK/title.txt"
RUNTIME_FILE="$WORK/runtime.txt"
LABEL_FILE="$WORK/label.txt"
STAMP_FILE="$WORK/stamp.txt"
LOG="${FFMPEG_LOG:-/tmp/prime-lite-ffmpeg.log}"
SERVER_PID=""
QUOTE_PID=""
RUNTIME_PID=""
ENCODER_PID=""
SLATE_PID=""
UPDATER_PID=""
STOPPING=0

# Shutdown
cleanup() {
  (( STOPPING )) && return 0
  STOPPING=1
  trap - EXIT INT TERM
  for pid in "$ENCODER_PID" "$SLATE_PID" "$UPDATER_PID" "$RUNTIME_PID" "$QUOTE_PID" "$SERVER_PID"; do
    if [[ -n "$pid" ]]; then kill "$pid" 2>/dev/null || true; fi
  done
  for pid in "$ENCODER_PID" "$SLATE_PID" "$UPDATER_PID" "$RUNTIME_PID" "$QUOTE_PID" "$SERVER_PID"; do
    if [[ -n "$pid" ]]; then wait "$pid" 2>/dev/null || true; fi
  done
  rm -rf -- "$WORK"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Setup: delete only Prime's old output, not the cloud root
: > "$LOG"
mkdir -p "$ROOT_HLS_DIR"
[[ "$OUT" != / && "$OUT" != "$HOME" ]] || exit 1
rm -rf -- "$OUT"
mkdir -p "$OUT"
printf '%s  NQ -----\n' "$(date +%H:%M)" > "$QUOTE_FILE"
printf '%s\n' "${TITLE:-NOW PLAYING}" > "$TITLE_FILE"
printf '%s\n' '<< Rewind' > "$LABEL_FILE"
printf '%s\n' 'PLAY  00:00:00' > "$RUNTIME_FILE"
printf '%s\n' '00:00:00.000' > "$STAMP_FILE"
printf '[{"number":"03","name":"PRIME","path":"/Prime/index.m3u8"}]\n' > "$ROOT_HLS_DIR/channels.json"

# Web Server
BIND_ADDR="$BIND_ADDR" PORT="$PORT" ROOT_HLS_DIR="$ROOT_HLS_DIR" python3 - <<'PY' &
import http.server, os
class Handler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=os.environ['ROOT_HLS_DIR'], **kwargs)
    def guess_type(self, path):
        if path.endswith('.m3u8'): return 'application/vnd.apple.mpegurl'
        if path.endswith('.ts'): return 'video/mp2t'
        return super().guess_type(path)
    def end_headers(self):
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Cache-Control', 'no-store')
        super().end_headers()
    def log_message(self, *args): pass
class Server(http.server.ThreadingHTTPServer):
    allow_reuse_address = True
Server((os.environ['BIND_ADDR'], int(os.environ['PORT'])), Handler).serve_forever()
PY
SERVER_PID=$!
sleep 0.3
kill -0 "$SERVER_PID" 2>/dev/null || { echo "Port $PORT unavailable" >&2; exit 1; }

# Quote And Clock (atomic file replacement)
# Parse both direct quotes and OHLC priceSeries responses.
QUOTE_URL="$QUOTE_URL" QUOTE_FILE="$QUOTE_FILE" python3 - <<'PYQUOTE' &
import json, os, time, urllib.request, math, sys
url = os.environ['QUOTE_URL'].rstrip('/') + '/NQ'
path = os.environ['QUOTE_FILE']
price = '-----'
next_request = 0

def extract(obj):
    if isinstance(obj, dict):
        for key in ('price', 'last', 'mark', 'close', 'c', 'value'):
            if obj.get(key) is not None:
                return obj[key]
        for key in ('priceSeries', 'prices', 'data', 'series'):
            series = obj.get(key)
            if isinstance(series, list) and series:
                return extract(series[-1])
            if isinstance(series, dict):
                return extract(series)
        high = obj.get('hi', obj.get('high'))
        low = obj.get('lo', obj.get('low'))
        if high is not None and low is not None:
            return (float(high) + float(low)) / 2
    if isinstance(obj, list) and obj:
        return extract(obj[-1])
    return obj

while True:
    now = time.time()
    if now >= next_request:
        next_request = now + 15
        try:
            request = urllib.request.Request(url, headers={'User-Agent': 'PrimeLite/1.1', 'Accept': 'application/json'})
            with urllib.request.urlopen(request, timeout=5) as response:
                data = json.load(response)
            value = float(extract(data))
            if not math.isfinite(value):
                raise ValueError('NQ quote is non-finite')
            price = str(math.trunc(value))
        except Exception as exc:
            print(f'[Prime Lite] NQ fetch failed: {exc}', file=sys.stderr, flush=True)
    temp = path + '.new'
    with open(temp, 'w') as f:
        f.write(time.strftime('%H:%M') + '  NQ ' + price + '\n')
    os.replace(temp, path)
    time.sleep(1)
PYQUOTE
QUOTE_PID=$!

# Filters: scale, logo, clock/quote, title, runtime flag
# Text files remain stable paths; the quote is replaced atomically.
# Resolve Comic Shanns by installed family or filename, never silently choose sans.
FONT="${COMIC_SHANNS_FONT:-}"
if [[ -z "$FONT" ]] && command -v fc-list >/dev/null 2>&1; then
  FONT="$(fc-list -f '%{family}\t%{file}\n' 2>/dev/null | awk -F '\t' 'tolower($1) ~ /comic ?shanns/ {print $2; exit}')"
fi
if [[ -z "$FONT" ]]; then
  for candidate in \
    "$HOME/.local/share/fonts/ComicShannsMonoNerdFont-Regular.otf" \
    "$HOME/.local/share/fonts/ComicShannsMono-Regular.otf" \
    "/usr/share/fonts/OTF/ComicShannsMonoNerdFont-Regular.otf" \
    "/usr/local/share/fonts/ComicShannsMonoNerdFont-Regular.otf"; do
    if [[ -f "$candidate" ]]; then FONT="$candidate"; break; fi
  done
fi
FONT_OPT=""
if [[ -f "$FONT" ]]; then
  FONT_OPT="fontfile='$FONT':"
  echo "[Prime Lite] Font: $FONT"
else
  # Fontconfig resolves this on hosts where the exact file path differs.
  FONT_OPT="font='ComicShannsMono Nerd Font':"
  echo '[Prime Lite] Comic Shanns file not found; requesting ComicShannsMono Nerd Font via fontconfig.' >&2
fi
BASE="fps=$FPS,scale=$SIZE:force_original_aspect_ratio=decrease,pad=${SIZE}:(ow-iw)/2:(oh-ih)/2,setsar=1,format=yuv420p"
QUOTE_DRAW="drawtext=${FONT_OPT}textfile='$QUOTE_FILE':reload=1:x=w-tw-24:y=h-th-56:fontsize=12:fontcolor=white:box=1:boxcolor=black@0.55:boxborderw=3"
RUNTIME_DRAW="drawtext=${FONT_OPT}textfile='$RUNTIME_FILE':reload=1:x=24:y=h-th-34:fontsize=12:fontcolor=white:box=1:boxcolor=black@0.55:boxborderw=3"
TITLE_DRAW="drawtext=${FONT_OPT}textfile='$TITLE_FILE':x=w-tw-24:y=h-th-37:fontsize=11:fontcolor=white:box=1:boxcolor=black@0.55:boxborderw=3"

# HLS Settings: epoch-numbered segments prevent overwriting old live segments.
HLS=( -f hls -hls_time 2 -hls_list_size 6 -hls_start_number_source epoch
      -hls_flags 'delete_segments+omit_endlist+append_list+independent_segments+discont_start'
      -hls_segment_filename "$OUT/seg_%d.ts" "$OUT/index.m3u8" )
VIDEO=( -c:v libx264 -preset veryfast -b:v 1000k -maxrate 1300k -bufsize 2600k
        -pix_fmt yuv420p -g "$((FPS * 2))" -keyint_min "$((FPS * 2))" -sc_threshold 0 )
AUDIO=( -c:a aac -b:a 96k -ar 44100 -ac 2 )

# Encode One Movie
play_movie() {
  local file="$1" status=0 name
  name="${TITLE:-$(basename "${file%.*}")}" 
  printf '%s\n' "On now:  $name" > "$TITLE_FILE"
  echo "[Prime Lite] Playing: $name"
  # VCR elapsed-time flag. Monotonic time avoids wall-clock jumps.
  if (( SHOW_RUNTIME )); then
  RUNTIME_FILE="$RUNTIME_FILE" python3 - <<'PYRUNTIME' &
import os, time
path = os.environ['RUNTIME_FILE']
started = time.monotonic()
previous = None
while True:
    seconds = int(time.monotonic() - started)
    if seconds != previous:
        hours, rem = divmod(seconds, 3600)
        minutes, secs = divmod(rem, 60)
        tmp = path + '.new'
        with open(tmp, 'w') as f:
            f.write(f'PLAY  {hours:02}:{minutes:02}:{secs:02}\n')
        os.replace(tmp, path)
        previous = seconds
    time.sleep(.15)
PYRUNTIME
  RUNTIME_PID=$!
  fi
  local graph="[0:v]$BASE[base];"
  local inputs=( -re -i "$file" )
  if [[ -f "$LOGO" ]]; then
    inputs+=( -loop 1 -framerate "$FPS" -i "$LOGO" )
    graph+="[1:v]scale=55:-1,format=rgba[logo];[base][logo]overlay=24:H-h-58:shortest=1[decorated];"
  else
    graph+="[base]null[decorated];"
  fi
  if (( SHOW_RUNTIME )); then
    graph+="[decorated]$QUOTE_DRAW,$TITLE_DRAW,$RUNTIME_DRAW[v]"
  else
    graph+="[decorated]$QUOTE_DRAW,$TITLE_DRAW[v]"
  fi
  "$FFMPEG" -nostdin -hide_banner -loglevel warning "${inputs[@]}" \
    -filter_complex "$graph" -map '[v]' -map '0:a:0?' \
    "${VIDEO[@]}" "${AUDIO[@]}" "${HLS[@]}" >> "$LOG" 2>&1 &
  ENCODER_PID=$!
  wait "$ENCODER_PID" || status=$?
  ENCODER_PID=""
  kill "$RUNTIME_PID" 2>/dev/null || true
  wait "$RUNTIME_PID" 2>/dev/null || true
  RUNTIME_PID=""
  return "$status"
}

# Rewind Slate: a blue screen, mechanically eased countdown, zero, then Play >
rewind_movie() {
  local file="$1" ms duration status=0
  duration="$("$FFPROBE" -v error -show_entries format=duration -of default=nw=1:nk=1 "$file" 2>/dev/null || echo 0)"
  ms="$(python3 - "$duration" <<'PY'
import sys
try: print(max(0, round(float(sys.argv[1])*1000)))
except: print(0)
PY
)"
  printf '<< Rewind\n' > "$LABEL_FILE"
  REWIND_SECONDS="$REWIND_SECONDS" STAMP_FILE="$STAMP_FILE" LABEL_FILE="$LABEL_FILE" MS="$ms" python3 - <<'PY' &
import os, time
length = max(.01, float(os.environ['REWIND_SECONDS']))
total = int(os.environ['MS'])
label = os.environ['LABEL_FILE']; path = os.environ['STAMP_FILE']
def write(p, s):
    tmp = p+'.new'
    with open(tmp,'w') as f: f.write(s+'\n')
    os.replace(tmp,p)
def fmt(ms):
    s, ms = divmod(max(0,ms),1000)
    m, s = divmod(s,60)
    h, m = divmod(m,60)
    return f'{h:02}:{m:02}:{s:02}.{ms:03}'
start = time.monotonic()
while True:
    t = min(1., (time.monotonic()-start)/length)
    r = .18
    speed = 1/(1-r)
    progress = (.5*speed*t*t/r if t < r else
                .5*speed*r+speed*(t-r) if t <= 1-r else
                1-.5*speed*(1-t)*(1-t)/r)
    write(path,fmt(round(total*(1-progress))))
    if t >= 1: break
    time.sleep(.04)
write(path,fmt(0))
time.sleep(.35)
write(label,'Play >')
PY
  UPDATER_PID=$!
  local slate_length
  slate_length="$(python3 - "$REWIND_SECONDS" <<'PY'
import sys
print(float(sys.argv[1]) + 1.35)
PY
)"
  "$FFMPEG" -nostdin -hide_banner -loglevel warning \
    -re -f lavfi -i "color=c=0x0000AA:s=${SIZE/:/x}:r=$FPS" \
    -re -f lavfi -i 'anullsrc=r=44100:cl=stereo' \
    -t "$slate_length" -vf "drawtext=${FONT_OPT}textfile='$LABEL_FILE':reload=1:x=(w-tw)/2:y=h/2-45:fontsize=32:fontcolor=white,drawtext=${FONT_OPT}textfile='$STAMP_FILE':reload=1:x=(w-tw)/2:y=h/2+8:fontsize=24:fontcolor=white" \
    -map 0:v -map 1:a "${VIDEO[@]}" "${AUDIO[@]}" "${HLS[@]}" >> "$LOG" 2>&1 &
  SLATE_PID=$!
  wait "$SLATE_PID" || status=$?
  SLATE_PID=""
  kill "$UPDATER_PID" 2>/dev/null || true
  wait "$UPDATER_PID" 2>/dev/null || true
  UPDATER_PID=""
  return "$status"
}

# Programming Loop
collect_media() {
  if [[ -f "$MEDIA" ]]; then printf '%s\0' "$MEDIA"; return; fi
  find "$MEDIA" -type f \( -iname '*.mp4' -o -iname '*.mkv' -o -iname '*.mov' -o -iname '*.m4v' -o -iname '*.webm' \) -print0
}
mapfile -d '' -t FILES < <(collect_media)
(( ${#FILES[@]} )) || { echo 'No media files found' >&2; exit 1; }
echo "[Prime Lite] http://$BIND_ADDR:$PORT/Prime/index.m3u8"
echo "[Prime Lite] Log: $LOG"
while true; do
  for file in "${FILES[@]}"; do
    if play_movie "$file"; then
      if [[ -f "$MEDIA" ]]; then
        rewind_movie "$file" || echo '[Prime Lite] Rewind failed; continuing.' >&2
      fi
    else
      echo '[Prime Lite] FFmpeg failed. Recent errors:' >&2
      tail -n 12 "$LOG" >&2
      sleep 2
    fi
  done
done

