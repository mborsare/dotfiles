#!/usr/bin/env bash
set -euo pipefail

# --- Configuration ---
PORT="8090"
BIND_ADDR="127.0.0.1"
ROOT_HLS_DIR="/tmp/broadcast-hls"
FFMPEG="ffmpeg"
FFPROBE="ffprobe"
LOGO_PATH="$HOME/Documents/Prime/logotype.png"
SERVER_PID=""


CLOCK_FILE="/tmp/broadcast-clocks-$$.txt"
NQ_NOW_FILE="/tmp/broadcast-nq-now-$$.txt"
HEADLINE_FILE="/tmp/broadcast-headlines-$$.txt"
SLEEP_FILE="/tmp/broadcast-sleep.txt"

NQ_NOW_URL="https://weather.mborsare.workers.dev/prime/weather/NQ"

HEADLINE_SOURCES=(
  "NYT|https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml"
  "WAPO|https://feeds.washingtonpost.com/rss/homepage"
  "BBC|https://feeds.bbci.co.uk/news/rss.xml"
  "AP|https://feeds.apnews.com/rss/apf-topnews"
)

OUTPUT_FPS="24"
VIDEO_BITRATE="1600k"
VIDEO_MAXRATE="2000k"
VIDEO_BUFSIZE="4000k"
AUDIO_BITRATE="96k"

HLS_TIME="1"
HLS_LIST_SIZE="6"
HLS_DELETE_THRESHOLD="3"

DEFAULT_MEDIA_DIR="$HOME/Documents/Will-broadcast/"
DEFAULT_SIZE="960:540"

CHANNELS=()

if [[ $# -gt 0 ]]; then
  n=1
  for input in "$@"; do
    if [[ ! -e "$input" ]]; then
      echo "No such file or folder: $input" >&2
      exit 1
    fi

    if [[ $# -eq 1 ]]; then
      CHANNELS+=("Prime|Prime|$input|$DEFAULT_SIZE")
    else
      CHANNELS+=("Prime$n|Prime $n|$input|$DEFAULT_SIZE")
    fi

    n=$((n + 1))
  done
else
  CHANNELS+=("Prime|Prime|$DEFAULT_MEDIA_DIR|$DEFAULT_SIZE")
fi

STOP_FILE="/tmp/broadcast-stop-$$"

kill_port_listeners() {
  local pids=""

  if command -v lsof >/dev/null 2>&1; then
    pids="$(lsof -ti :"$PORT" 2>/dev/null || true)"
  elif command -v fuser >/dev/null 2>&1; then
    pids="$(fuser -n tcp "$PORT" 2>/dev/null || true)"
  fi

  if [[ -n "$pids" ]]; then
    kill -9 $pids 2>/dev/null || true
  fi
}

require_runtime() {
  local missing=()
  local cmd

  for cmd in "$FFMPEG" "$FFPROBE" python3 curl; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      missing+=("$cmd")
    fi
  done

  if ! command -v lsof >/dev/null 2>&1 && ! command -v fuser >/dev/null 2>&1; then
    missing+=("lsof or fuser")
  fi

  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Missing required app(s): ${missing[*]}" >&2
    exit 1
  fi

  if [[ ! -f "$LOGO_PATH" ]]; then
    echo "[warn] Logo not found, continuing without logo: $LOGO_PATH" >&2
  fi
}

cleanup() {
  touch "$STOP_FILE"
  echo -e "\n\033[0;31m[!] Atomic Cleanup Initiated...\033[0m"

  kill_port_listeners

  local pids
  pids="$(jobs -pr || true)"
  if [[ -n "$pids" ]]; then
    kill $pids 2>/dev/null || true
  fi

  pkill -9 -f "$ROOT_HLS_DIR" 2>/dev/null || true
  rm -rf "$ROOT_HLS_DIR"

  rm -f "$STOP_FILE"
  rm -f "$CLOCK_FILE"
  rm -f "$NQ_NOW_FILE"
  rm -f "$HEADLINE_FILE"
  : > "$SLEEP_FILE"

  echo "[+] Broadcast stopped."
  exit 0
}
trap cleanup EXIT INT TERM

start_server() {
  echo "[*] Starting Web Server on $BIND_ADDR:$PORT..."
  BIND_ADDR="$BIND_ADDR" PORT="$PORT" ROOT_HLS_DIR="$ROOT_HLS_DIR" python3 - >/tmp/broadcast-server.log 2>&1 <<'PY' &
import http.server
import os

BIND_ADDR = os.environ["BIND_ADDR"]
PORT = int(os.environ["PORT"])
ROOT = os.environ["ROOT_HLS_DIR"]

class HLSHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=ROOT, **kwargs)

    def guess_type(self, path):
        if str(path).endswith(".m3u8"):
            return "application/vnd.apple.mpegurl"
        if str(path).endswith(".ts"):
            return "video/mp2t"
        if str(path).endswith(".json"):
            return "application/json"
        return super().guess_type(path)

    def end_headers(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "no-cache")
        super().end_headers()

    def log_message(self, fmt, *args):
        pass

http.server.HTTPServer((BIND_ADDR, PORT), HLSHandler).serve_forever()
PY
  SERVER_PID="$!"
}

wait_for_server() {
  local url="http://127.0.0.1:$PORT/channels.json"
  local i

  for i in {1..50}; do
    if curl -sf --max-time 1 "$url" >/dev/null 2>&1; then
      return 0
    fi

    if [[ -n "$SERVER_PID" ]] && ! kill -0 "$SERVER_PID" 2>/dev/null; then
      echo "[error] Web server exited before it was reachable." >&2
      cat /tmp/broadcast-server.log >&2 2>/dev/null || true
      exit 1
    fi

    sleep 0.1
  done

  echo "[error] Web server did not become reachable at $url" >&2
  cat /tmp/broadcast-server.log >&2 2>/dev/null || true
  exit 1
}

start_clock_file() {
  (
    while [[ ! -f "$STOP_FILE" ]]; do
      local nq_now
      nq_now="$(cat "$NQ_NOW_FILE" 2>/dev/null || printf "-----")"

      printf "Now is %s  //  NQ %s\n" \
        "$(date '+%H:%M:%S')" \
        "$nq_now" \
        > "$CLOCK_FILE"

      sleep 1
    done
  ) &
}

start_nq_now_file() {
  (
    while [[ ! -f "$STOP_FILE" ]]; do
      curl -sf --max-time 5 "$NQ_NOW_URL" \
        | python3 -c '
import json
import sys

nq_now_file = "'"$NQ_NOW_FILE"'"

try:
    d = json.load(sys.stdin)
    prices = d.get("priceSeries", [])

    if not prices:
        raise ValueError("missing data")

    latest = prices[-1]
    latest_mid = (float(latest["hi"]) + float(latest["lo"])) / 2

    with open(nq_now_file, "w") as f:
        f.write(str(int(latest_mid)))

except Exception:
    with open(nq_now_file, "w") as f:
        f.write("-----")
' || printf -- "-----\n" > "$NQ_NOW_FILE"

      sleep 60
    done
  ) &
}

fetch_headline() {
  python3 - "${HEADLINE_SOURCES[@]}" <<'PY'
import random
import re
import sys
import urllib.request
import xml.etree.ElementTree as ET
from html import unescape

LIMIT_PER_SOURCE = 8
PICKS = 5

items = []
seen = set()

def clean(s):
    s = unescape(s or "")
    s = re.sub(r"<[^>]+>", " ", s)
    s = re.sub(r"[\r\n\t]+", " ", s)
    s = re.sub(r"[\\'%\[\]=]", " ", s)
    s = re.sub(r"\s+", " ", s).strip()
    return s[:180]

for raw in sys.argv[1:]:
    try:
        label, feed = raw.split("|", 1)

        req = urllib.request.Request(
            feed,
            headers={
                "User-Agent": "Mozilla/5.0 PrimeBroadcast/1.0",
                "Accept": "application/rss+xml, application/xml, text/xml, */*",
            },
        )

        with urllib.request.urlopen(req, timeout=4) as response:
            body = response.read()

        root = ET.fromstring(body)

        found = []

        # RSS: channel/item/title
        for item in root.findall(".//item"):
            title_el = item.find("title")
            if title_el is not None and title_el.text:
                found.append(title_el.text)

        # Atom fallback: entry/title
        if not found:
            ns = {"atom": "http://www.w3.org/2005/Atom"}
            for entry in root.findall(".//atom:entry", ns):
                title_el = entry.find("atom:title", ns)
                if title_el is not None and title_el.text:
                    found.append(title_el.text)

        for title in found[:LIMIT_PER_SOURCE]:
            title = clean(title)
            if not title:
                continue

            key = title.lower()
            if key in seen:
                continue

            seen.add(key)
            items.append(f"{label}: {title}")

    except Exception:
        continue

if items:
    random.shuffle(items)
    print("   //   ".join(items[:PICKS]))
else:
    print("PRIME BROADCAST")
PY
}

start_headline_file() {
  (
    while [[ ! -f "$STOP_FILE" ]]; do
      local headline
      headline="$(fetch_headline)"

      if [[ -z "$headline" ]]; then
        headline="PRIME BROADCAST"
      fi

      printf "%s\n" "$headline" > "$HEADLINE_FILE"
      echo -e "\033[0;33m[chyron]\033[0m $headline"

      sleep 600
    done
  ) &
}

write_channel_manifest() {
  local manifest="$ROOT_HLS_DIR/channels.json"

  python3 - "$manifest" "${CHANNELS[@]}" <<'PY'
import json
import sys

manifest = sys.argv[1]
channels = sys.argv[2:]

out = []

for i, raw in enumerate(channels):
    name, display_name, _media_path, _size = raw.split("|", 3)

    out.append({
        "number": f"{i + 3:02d}",
        "name": display_name.upper(),
        "path": f"/{name}/index.m3u8"
    })

with open(manifest, "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2)
    f.write("\n")
PY
}

write_concat_playlist() {
  local media_path="$1"
  local playlist_ffconcat="$2"

  python3 - "$media_path" "$playlist_ffconcat" "$FFPROBE" <<'PY'
import random
import subprocess
import sys
from pathlib import Path

media_path = Path(sys.argv[1]).expanduser()
playlist = Path(sys.argv[2])
ffprobe = sys.argv[3]

exts = {".mp4", ".mkv", ".mov", ".m4v", ".webm"}

def has_video(path):
    try:
        r = subprocess.run(
            [
                ffprobe,
                "-v", "error",
                "-select_streams", "v:0",
                "-show_entries", "stream=codec_type",
                "-of", "csv=p=0",
                str(path),
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=8,
        )
        return r.returncode == 0 and "video" in r.stdout
    except Exception:
        return False

if media_path.is_file():
    candidates = [media_path.resolve()]
elif media_path.is_dir():
    candidates = [
        p.resolve()
        for p in media_path.rglob("*")
        if p.is_file() and p.suffix.lower() in exts
    ]
else:
    raise SystemExit(f"No such file or folder: {media_path}")

good = []
bad = []

for path in candidates:
    if has_video(path):
        good.append(path)
    else:
        bad.append(path)

good.sort(key=lambda p: str(p).lower())
random.shuffle(good)

for path in bad:
    print(f"[skip bad media] {path}", file=sys.stderr)

if not good:
    raise SystemExit(f"No playable media files found in {media_path}")

def ffconcat_quote(path: Path) -> str:
    s = str(path)
    return "'" + s.replace("'", "'\\''") + "'"

with playlist.open("w", encoding="utf-8") as f:
    f.write("ffconcat version 1.0\n")
    for path in good:
        f.write(f"file {ffconcat_quote(path)}\n")
PY
}

build_video_filter() {
  local width="$1"
  local height="$2"
  local font_path=""
  local font_arg=""

  if command -v fc-match >/dev/null 2>&1; then
    font_path="$(fc-match -f '%{file}\n' 'ComicShannsMono Nerd Font' 2>/dev/null | head -n 1 || true)"
  fi

  if [[ -z "$font_path" || ! -f "$font_path" ]]; then
    font_path="/usr/share/fonts/OTF/ComicShannsMonoNerdFont-Regular.otf"
  fi

  if [[ -f "$font_path" ]]; then
    font_arg="fontfile='$font_path':"
  fi

  local v_filter
  v_filter="fps=$OUTPUT_FPS,"
  v_filter+="setsar=1,"
  v_filter+="scale=$width:$height:force_original_aspect_ratio=decrease:force_divisible_by=2,"
  v_filter+="pad=$width:$height:(ow-iw)/2:(oh-ih)/2,"
  v_filter+="setsar=1,format=yuv420p [main];"

  if [[ -f "$LOGO_PATH" ]]; then
    v_filter+="movie='$LOGO_PATH',scale=76:-1 [logo];"
    v_filter+="[main][logo] overlay=W-w-22:24 [combined];"
  else
    v_filter+="[main] null [combined];"
  fi

  v_filter+="[combined] drawtext="
  v_filter+="$font_arg"
  v_filter+="textfile='$CLOCK_FILE':"
  v_filter+="reload=1:"
  v_filter+="x=24:"
  v_filter+="y=20:"
  v_filter+="fontsize=15:"
  v_filter+="fontcolor=0xF4E66A [clocked];"

  v_filter+="[clocked] drawtext="
  v_filter+="$font_arg"
  v_filter+="textfile='$HEADLINE_FILE':"
  v_filter+="reload=1:"
  v_filter+="x=W-mod(t*42\\,W+tw):"
  v_filter+="y=H-36:"
  v_filter+="fontsize=20:"
  v_filter+="fontcolor=0xF4E66A [headlined];"

  v_filter+="[headlined] drawtext="
  v_filter+="$font_arg"
  v_filter+="textfile='$SLEEP_FILE':"
  v_filter+="reload=1:"
  v_filter+="x=W-tw-24:"
  v_filter+="y=H-th-62:"
  v_filter+="fontsize=18:"
  v_filter+="fontcolor=white:"
  v_filter+="box=1:"
  v_filter+="boxcolor=black@0.55:"
  v_filter+="boxborderw=8"

  printf "%s" "$v_filter"
}

start_channel() {
  local name="$1"
  local display_name="$2"
  local media_path="$3"
  local size="$4"
  local width="${size%%:*}"
  local height="${size##*:}"
  local hls_dir="$ROOT_HLS_DIR/$name"
  local playlist_ffconcat="$hls_dir/files.ffconcat"
  local v_filter

  mkdir -p "$hls_dir"

  write_concat_playlist "$media_path" "$playlist_ffconcat"
  v_filter="$(build_video_filter "$width" "$height")"

  echo -e "\033[0;34m[$display_name]\033[0m Starting efficient always-on channel encoder..."
  echo "source: $media_path"

  (
    while [[ ! -f "$STOP_FILE" ]]; do
      "$FFMPEG" -nostdin -hide_banner -loglevel warning \
        -re \
        -stream_loop -1 \
        -fflags +genpts+discardcorrupt \
        -err_detect ignore_err \
        -f concat \
        -safe 0 \
        -i "$playlist_ffconcat" \
        -vf "$v_filter" \
        -c:v libx264 \
        -preset veryfast \
        -profile:v main \
        -b:v "$VIDEO_BITRATE" \
        -maxrate "$VIDEO_MAXRATE" \
        -bufsize "$VIDEO_BUFSIZE" \
        -g "$((OUTPUT_FPS * HLS_TIME))" \
        -pix_fmt yuv420p \
        -af "aresample=async=1:first_pts=0" \
        -c:a aac \
        -b:a "$AUDIO_BITRATE" \
        -ar 44100 \
        -ac 2 \
        -f hls \
        -hls_time "$HLS_TIME" \
        -hls_list_size "$HLS_LIST_SIZE" \
        -hls_start_number_source epoch \
        -hls_flags delete_segments+omit_endlist+program_date_time+independent_segments \
        -hls_delete_threshold "$HLS_DELETE_THRESHOLD" \
        -hls_segment_filename "$hls_dir/seg_%d.ts" \
        "$hls_dir/index.m3u8"

      if [[ ! -f "$STOP_FILE" ]]; then
        echo -e "\033[0;31m[$display_name]\033[0m Encoder exited. Restarting in 2 seconds..."
        sleep 2
      fi
    done
  ) &
}

# --- Execution ---
require_runtime

kill_port_listeners
pkill -9 -f "$ROOT_HLS_DIR" 2>/dev/null || true

rm -rf "$ROOT_HLS_DIR"
mkdir -p "$ROOT_HLS_DIR"

rm -f "$STOP_FILE"
rm -f "$CLOCK_FILE"
rm -f "$NQ_NOW_FILE"
rm -f "$HEADLINE_FILE"

printf "Now is --:--:--  //  NQ -----\n" > "$CLOCK_FILE"
printf -- "-----\n" > "$NQ_NOW_FILE"
printf "PRIME BROADCAST\n" > "$HEADLINE_FILE"
: > "$SLEEP_FILE"

write_channel_manifest

start_server
wait_for_server
start_clock_file
start_nq_now_file
start_headline_file

for channel in "${CHANNELS[@]}"; do
  IFS='|' read -r name display_name media_path size <<< "$channel"
  start_channel "$name" "$display_name" "$media_path" "$size"
done

echo "[*] Initializing streams..."

for channel in "${CHANNELS[@]}"; do
  IFS='|' read -r name _ _ _ <<< "$channel"
  ready=0

for _ in {1..120}; do
  if [[ -f "$ROOT_HLS_DIR/$name/index.m3u8" ]]; then
    ready=1
    break
  fi
  sleep 0.5
done

if [[ "$ready" -ne 1 ]]; then
  echo "[error] $name never produced index.m3u8" >&2
  exit 1
fi
done

echo -e "\n\033[1;32m------------------------------------------------\033[0m"
echo -e "\033[1;32m   PRIME BROADCAST LIVE \033[0m"
echo -e "\033[1;32m------------------------------------------------\033[0m"

echo -e "\033[1mManifest:\033[0m http://localhost:$PORT/channels.json"
echo ""

for channel in "${CHANNELS[@]}"; do
  IFS='|' read -r name display_name media_path _ <<< "$channel"
  echo -e "\033[1mChannel:\033[0m $display_name"
  echo "Source: $media_path"
  echo "http://localhost:$PORT/$name/index.m3u8"
  echo ""
done

echo "Press Ctrl+C to stop."
wait


