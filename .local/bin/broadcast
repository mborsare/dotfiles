#!/usr/bin/env bash
set -euo pipefail

# Configuration
PORT="${PORT:-8090}"
BIND_ADDR="${BIND_ADDR:-127.0.0.1}"
ROOT_HLS_DIR="${ROOT_HLS_DIR:-$HOME/cloud/broadcast-hls}"
MEDIA_PATH="${DEFAULT_MEDIA_DIR:-$HOME/Documents/Will-broadcast}"
LOGO_PATH="${LOGO_PATH:-$HOME/.local/share/broadcast/mike-logo.png}"
DEFAULT_SIZE="${DEFAULT_SIZE:-640:360}"
OUTPUT_FPS="${OUTPUT_FPS:-30}"
QUOTE_BASE_URL="${QUOTE_BASE_URL:-https://weather.mborsare.workers.dev/prime/weather}"
REWIND_SECONDS="${REWIND_SECONDS:-10}"
FFMPEG="${FFMPEG:-ffmpeg}"
FFPROBE="${FFPROBE:-ffprobe}"
COMIC_SHANNS_FONT="${COMIC_SHANNS_FONT:-}"
SHOW_RUNTIME=1
ANALOG=0
TAPE_WEAR=0
NOW_PLAYING_TITLE=""
media_set=0

# Arguments
while (( $# )); do
  case "$1" in
    --runtime) SHOW_RUNTIME=1; shift ;;
    --analog) ANALOG=1; shift ;;
    --tape-wear) TAPE_WEAR=1; shift ;;
    --now-playing)
      (( $# >= 2 )) || { echo '--now-playing needs a title' >&2; exit 2; }
      NOW_PLAYING_TITLE="$2"; shift 2 ;;
    --help|-h)
      echo 'usage: broadcast [MOVIE_OR_DIRECTORY] [--runtime] [--analog] [--tape-wear] [--now-playing TITLE]'
      echo 'One persistent HLS encoder. Movies and rewind feed a single MPEG-TS pipe.'
      echo '  --analog  Add VHS softness, color bleed, grain, scanlines, and tracking errors.'
      echo '  --tape-wear  Start clean; wear each source picture into pixel rubble and static.'
      echo '               Damage increases after every completed play.'
      echo '               Display only; files and audio are unchanged. Resets on restart.'
      exit 0 ;;
    --) shift; (( $# == 1 && ! media_set )) || exit 2; MEDIA_PATH="$1"; media_set=1; shift ;;
    -*) echo "Unknown argument: $1" >&2; exit 2 ;;
    *) (( ! media_set )) || { echo 'Only one media path is allowed' >&2; exit 2; }
       MEDIA_PATH="$1"; media_set=1; shift ;;
  esac
done
[[ -e "$MEDIA_PATH" ]] || { echo "Missing media: $MEDIA_PATH" >&2; exit 1; }
for binary in "$FFMPEG" "$FFPROBE" python3; do
  command -v "$binary" >/dev/null || { echo "Missing $binary" >&2; exit 1; }
done

# Comic Shanns: working original broadcaster's exact lookup
if [[ -z "$COMIC_SHANNS_FONT" ]] && command -v fc-match >/dev/null 2>&1; then
  COMIC_SHANNS_FONT="$(fc-match -f '%{file}\n' 'ComicShannsMono Nerd Font' 2>/dev/null | head -n 1 || true)"
fi
if [[ ! -f "$COMIC_SHANNS_FONT" ]]; then
  COMIC_SHANNS_FONT='/usr/share/fonts/OTF/ComicShannsMonoNerdFont-Regular.otf'
fi
[[ -f "$COMIC_SHANNS_FONT" ]] || COMIC_SHANNS_FONT=''
export PORT BIND_ADDR ROOT_HLS_DIR MEDIA_PATH LOGO_PATH DEFAULT_SIZE OUTPUT_FPS
export QUOTE_BASE_URL REWIND_SECONDS FFMPEG FFPROBE COMIC_SHANNS_FONT
export SHOW_RUNTIME NOW_PLAYING_TITLE ANALOG TAPE_WEAR

# Continuous Controller
exec python3 - <<'PY'
import http.server
import json
import math
import os
from pathlib import Path
import random
import select
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.request

port = int(os.environ['PORT'])
bind = os.environ['BIND_ADDR']
root = Path(os.environ['ROOT_HLS_DIR']).expanduser()
media = Path(os.environ['MEDIA_PATH']).expanduser()
logo = Path(os.environ['LOGO_PATH']).expanduser()
w, h = [int(x) for x in os.environ['DEFAULT_SIZE'].split(':')]
fps = int(os.environ['OUTPUT_FPS'])
rewind_secs = max(0.1, float(os.environ['REWIND_SECONDS']))
ffmpeg = os.environ['FFMPEG']
ffprobe = os.environ['FFPROBE']
font = os.environ['COMIC_SHANNS_FONT']
title_override = os.environ['NOW_PLAYING_TITLE']
show_runtime = os.environ['SHOW_RUNTIME'] == '1'
analog = os.environ['ANALOG'] == '1'
tape_wear = os.environ['TAPE_WEAR'] == '1'
quote_url = os.environ['QUOTE_BASE_URL'].rstrip('/') + '/NQ'
log_path = Path(os.environ.get('FFMPEG_LOG', '/tmp/prime-lite-ffmpeg.log'))
out = root/'Prime'
work = Path(tempfile.mkdtemp(prefix='prime-lite-'))
stop = threading.Event()
mode = ['movie']
processes = []
playlist = []
playlist_index = 0
resume_offset = 0.0
transport_position = 0.0
broadcast_started = time.monotonic()
completed_plays = {}

if w % 2 or h % 2 or w < 2 or h < 2 or fps < 1:
    raise SystemExit('DEFAULT_SIZE must have even positive dimensions; FPS >=1')

def atomic(path, value):
    # Writers can overlap at movie/rewind boundaries. Never share a staging
    # inode: another writer could truncate it after it becomes the live file.
    fd, name = tempfile.mkstemp(prefix=path.name+'.', suffix='.new', dir=path.parent)
    new = Path(name)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as stream:
            stream.write(value+'\n')
        os.replace(new, path)
    finally:
        new.unlink(missing_ok=True)

def esc(value):
    return str(value).replace('\\', '\\\\').replace(':', '\\:').replace("'", "\\'").replace(',', '\\,')

def draw(file, fontsize, x, y, box=True):
    f = f"fontfile='{esc(font)}':" if font else ''
    b = ':box=1:boxcolor=black@0.55:boxborderw=3' if box else ''
    return f"drawtext={f}textfile='{esc(file)}':reload=1:x={x}:y={y}:fontsize={fontsize}:fontcolor=white{b}"

def analog_filter(strength=1.0):
    # --analog applies this after overlays; --tape-wear applies it to the source.
    # Keep dimensions, frame rate, and timestamps intact for continuous HLS.
    base = ','.join((
        f'gblur=sigma={0.45*strength:.4f}',
        f'gblur=sigma={1.1*strength:.4f}:planes=6',
        f'chromashift=cbh={round(2*strength)}:crh={-round(2*strength)}',
        f'eq=contrast={1+0.04*strength:.4f}:brightness={0.015*strength:.4f}:saturation={1-0.18*strength:.4f}',
        f'noise=alls={5*strength:.4f}:allf=t+u',
        f'drawgrid=width=iw:height=2:thickness=1:color=black@{0.07*strength:.4f}'))
    # Sparse, non-periodic tracking losses: a few damaged scanlines slip
    # sideways while the rest of the picture stays locked. Each event holds
    # for several frames; no continuous whole-frame oscillation.
    seed = random.randrange(1, 1000000)
    def irregular(clock, salt):
        return f'mod(abs(sin(({clock}+{seed}+{salt})*12.9898)*43758.5453),1)'
    event = irregular('floor(t/0.23)', 0)
    position = irregular('floor(t/0.23)', 71)
    shift = irregular('floor(t/0.07)', 139)
    band = max(2, min(h, 2 * round(h * 0.012 * strength)))
    y = f'2*floor((H-{band})*(0.82+0.18*({position}))/2)'
    crop_y = y.replace('H', 'ih')
    return (base + ',split=2[tape_clean][tape_error];'
            f'[tape_error]crop=iw:{band}:0:\'{crop_y}\','
            f"pad=iw+32:ih:16:0:color=black,crop=iw-32:ih:x='16+12*(2*({shift})-1)':y=0,"
            'noise=alls=32:allf=t+u[tape_band];'
            f"[tape_clean][tape_band]overlay=x=0:y='{y}':enable='lt({event},{0.035*strength:.4f})'")

def tape_wear_filter(plays):
    # Re-render from the untouched source. Wear belongs to a completed pass,
    # so an encoder retry/resume never ages the tape. Approach heavy damage
    # gradually without overflowing filter ranges during long broadcasts.
    if not plays:
        return ''
    strength = 4 * (1 - math.exp(-plays / 8))
    # Destroy spatial detail as well as color: fewer surviving pixels on each
    # pass, enlarged with hard edges. By pass 32 every block is lost to snow.
    # Native noise, lookup tables, and maskedmerge avoid interpreted per-pixel
    # trigonometry. Keep all damage on a bounded grid, then enlarge once.
    shrink = math.exp(-min(plays, 128) / 7)
    pw = min(w, max(2, 2 * round(max(16, w * shrink) / 2)))
    ph = min(h, max(2, 2 * round(max(10, h * shrink) / 2)))
    grid_scale = min(1.0, 96 / pw, 54 / ph)
    pw = max(2, 2 * int(pw * grid_scale / 2))
    ph = max(2, 2 * int(ph * grid_scale / 2))
    loss = min(1.0, (plays / 32) ** 1.4)
    seed = random.randrange(1, 1000000)
    # Uniform strength-100 noise on luma 128 spans [78,177]. A LUT turns
    # that into a binary dropout mask with the requested loss probability.
    threshold = 78 + 100 * loss
    return (
        f'scale={pw}:{ph}:flags=area,format=yuv420p,'
        f'eq=contrast={1+0.04*strength:.4f}:'
        f'saturation={(1-0.18*strength)*(1-loss):.4f},'
        'split=3[wear_picture][wear_mask_in][wear_snow_in];'
        '[wear_mask_in]lutyuv=y=128,'
        f'noise=c0s=100:c0f=t+u:c0_seed={seed},'
        f"lutyuv=y='if(lt(val,{threshold:.6f}),255,0)'[wear_mask];"
        '[wear_snow_in]lutyuv=y=128,'
        f'noise=c0s=100:c0f=t+u:c0_seed={seed+1},'
        "lutyuv=y='clip(16+(val-78)*2.19,16,235)'[wear_snow];"
        '[wear_picture][wear_snow][wear_mask]maskedmerge=planes=1,'
        f'scale={w}:{h}:flags=neighbor,format=yuv420p')

def probe(path, entry):
    result = subprocess.run([ffprobe, '-v','error','-show_entries',entry,
        '-of','default=noprint_wrappers=1:nokey=1',str(path)],
        capture_output=True, text=True, timeout=15)
    return result.stdout.strip() if result.returncode == 0 else ''

def fmt(ms):
    sec, milli = divmod(max(0,int(ms)),1000)
    minute, sec = divmod(sec,60)
    hour, minute = divmod(minute,60)
    return f'{hour:02}:{minute:02}:{sec:02}.{milli:03}'

def extract(d):
    if isinstance(d,dict):
        for k in ('price','last','mark','close','c','value'):
            if d.get(k) is not None: return d[k]
        for k in ('priceSeries','prices','data','series'):
            if d.get(k): return extract(d[k])
        hi=d.get('hi',d.get('high'))
        lo=d.get('lo',d.get('low'))
        if hi is not None and lo is not None: return (float(hi)+float(lo))/2
        raise ValueError('No price')
    if isinstance(d,list): return extract(d[-1])
    return d

class Handler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(root), **kwargs)
    def guess_type(self, path):
        if path.endswith('.m3u8'): return 'application/vnd.apple.mpegurl'
        if path.endswith('.ts'): return 'video/mp2t'
        if path.endswith('.json'): return 'application/json'
        return super().guess_type(path)
    def end_headers(self):
        self.send_header('Access-Control-Allow-Origin','*')
        self.send_header('Cache-Control','no-cache, no-store')
        super().end_headers()
    def log_message(self, *args): pass
class Server(http.server.ThreadingHTTPServer):
    allow_reuse_address=True
    daemon_threads=True

quote_file=work/'quote.txt'
title_file=work/'title.txt'
runtime_file=work/'runtime.txt'
uptime_file=work/'uptime.txt'
loop_file=work/'loop.txt'
rewind_label=work/'rewind-label.txt'
rewind_stamp=work/'rewind-stamp.txt'
rewind_frame_stamp=work/'rewind-frame-stamp.txt'
rewind_frame_label=work/'rewind-frame-label.txt'
play_frame_label=work/'play-frame-label.txt'
for file in (quote_file,title_file,runtime_file,rewind_label,rewind_stamp):
    atomic(file,'')
atomic(uptime_file,'UP 00:00:00')
atomic(loop_file,'LOOP 0')

def uptime_worker():
    while not stop.is_set():
        hours, remainder = divmod(int(time.monotonic()-broadcast_started), 3600)
        minutes, seconds = divmod(remainder, 60)
        atomic(uptime_file, f'UP {hours:02}:{minutes:02}:{seconds:02}')
        stop.wait(1)

def fetch_nq_price():
    urls = [
        quote_url,
        'https://query1.finance.yahoo.com/v8/finance/chart/NQ%3DF?range=1d&interval=1m',
        'https://query2.finance.yahoo.com/v8/finance/chart/NQ%3DF?range=1d&interval=1m',
    ]
    errors = []
    for url in urls:
        try:
            request = urllib.request.Request(url, headers={
                'User-Agent': 'Mozilla/5.0 (compatible; PrimeLite/1.3)',
                'Accept': 'application/json',
            })
            with urllib.request.urlopen(request, timeout=5) as response:
                payload = json.load(response)
            if url == quote_url:
                value = extract(payload)
            else:
                result = payload['chart']['result'][0]
                value = (result.get('meta') or {}).get('regularMarketPrice')
                if value is None:
                    closes = result['indicators']['quote'][0]['close']
                    value = next(price for price in reversed(closes) if price is not None)
            value = float(value)
            if not math.isfinite(value):
                raise ValueError('Non-finite price')
            return value
        except Exception as exc:
            errors.append(f'{url}: {exc}')
    raise ValueError('; '.join(errors))

def quote_worker():
    price='-----'
    next_refresh=0
    while not stop.is_set():
        now=time.monotonic()
        if now >= next_refresh:
            next_refresh=now+15
            try:
                price=str(math.trunc(fetch_nq_price()))
            except Exception as exc:
                print(f'[Prime Lite] NQ: {exc}',file=sys.stderr,flush=True)
        if mode[0]=='movie':
            atomic(quote_file, time.strftime('%H:%M')+'  NQ '+price)
        stop.wait(1)

# Pre-normalize each program to identical MPEG-TS transport parameters.
# One HLS encoder reads the concatenated bytes without closing stdin.
transport_video = ['-c:v','mpeg2video','-q:v','4','-g',str(2*fps),
                   '-pix_fmt','yuv420p']
transport_audio = ['-c:a','mp2','-b:a','128k','-ar','48000','-ac','2']
transport_output = ['-f','mpegts','-mpegts_flags','+resend_headers','pipe:1']

def transport_movie(path, offset=0):
    has_audio='audio' in probe(path,'stream=codec_type')
    cmd=[ffmpeg,'-nostdin','-hide_banner','-loglevel','error']
    if offset: cmd+=['-ss',str(offset)]
    cmd+=['-re','-i',str(path)]
    if not has_audio:
        cmd+=['-re','-f','lavfi','-i','anullsrc=r=48000:cl=stereo']
    vf=(f'fps={fps},scale={w}:{h}:force_original_aspect_ratio=decrease,'
        f'pad={w}:{h}:(ow-iw)/2:(oh-ih)/2,setsar=1,format=yuv420p')
    if tape_wear:
        wear_filter = tape_wear_filter(completed_plays.get(path, 0))
        if wear_filter:
            vf += ',' + wear_filter
    cmd+=['-map','0:v:0','-map','0:a:0' if has_audio else '1:a:0',
          '-vf',vf,'-af','aresample=async=1:first_pts=0',
          *transport_video,*transport_audio]
    if not has_audio: cmd+=['-shortest']
    return cmd+transport_output

def transport_rewind(duration, movie_duration):
    # Evaluate the tape position on each video frame, before pipe/HLS buffering.
    # Smooth acceleration and braking, with steady winding between them.
    fraction=f'min(1,max(0,t/{rewind_secs}))'
    ramp=.18
    speed=1/(1-ramp)
    progress=(f'if(lt({fraction},{ramp}),'
              f'{.5*speed/ramp}*pow({fraction},2),'
              f'if(lte({fraction},{1-ramp}),'
              f'{.5*speed*ramp}+{speed}*({fraction}-{ramp}),'
              f'1-{.5*speed/ramp}*pow(1-({fraction}),2)))')
    remaining=f'floor({max(0,movie_duration)*1000}*(1-({progress})))'
    def digits(expression, width):
        return '%{eif:'+expression+':d:'+str(width)+'}'
    atomic(rewind_frame_stamp,
           digits(f'floor(({remaining})/3600000)',2)+':'+
           digits(f'mod(floor(({remaining})/60000),60)',2)+':'+
           digits(f'mod(floor(({remaining})/1000),60)',2)+'.'+
           digits(f'mod({remaining},1000)',3))
    atomic(rewind_frame_label,'<< Rewind')
    atomic(play_frame_label,'Play >')
    switch=rewind_secs+.35
    vf=','.join((
        draw(rewind_frame_label,32,'(w-tw)/2','h/2-45',False)+f":enable='lt(t,{switch})'",
        draw(play_frame_label,32,'(w-tw)/2','h/2-45',False)+f":enable='gte(t,{switch})'",
        draw(rewind_frame_stamp,24,'(w-tw)/2','h/2+8',False)))
    cmd=[ffmpeg,'-nostdin','-hide_banner','-loglevel','error','-re',
         '-f','lavfi','-i',f'color=c=0x0000AA:s={w}x{h}:r={fps}',
         '-re','-f','lavfi','-i','anullsrc=r=48000:cl=stereo',
         '-map','0:v:0','-map','1:a:0','-t',str(duration),'-vf',vf,
         *transport_video,*transport_audio,*transport_output]
    return cmd

def reap(proc):
    if proc.poll() is None: proc.terminate()
    try: proc.wait(timeout=3)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()

def pump(cmd, encoder):
    global transport_position
    transport_position=0.0
    source=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=log_file,bufsize=0)
    processes.append(source)
    transferred=0
    pending=b''
    started=last_progress=time.monotonic()
    os.set_blocking(source.stdout.fileno(),False)
    os.set_blocking(encoder.stdin.fileno(),False)
    try:
        while not stop.is_set():
            if encoder.poll() is not None:
                raise RuntimeError(f'HLS encoder exited: {encoder.returncode}')
            if time.monotonic()-last_progress > 60:
                raise RuntimeError('Transport stalled for 60 seconds')
            readable,writable,_=select.select(
                [] if pending else [source.stdout],
                [encoder.stdin] if pending else [],[],1)
            if readable:
                data=os.read(source.stdout.fileno(),65536)
                if not data: break
                pending=data
            if writable:
                try: count=os.write(encoder.stdin.fileno(),pending)
                except BlockingIOError: continue
                pending=pending[count:]
                transferred+=count
                last_progress=time.monotonic()
                transport_position=max(0.0,last_progress-started-3.0)
        if not stop.is_set():
            source.wait(timeout=5)
            if source.returncode != 0:
                raise RuntimeError(f'Source exited {source.returncode}')
    finally:
        source.stdout.close()
        reap(source)
        processes.remove(source)
    return transferred

def source_files():
    if media.is_file(): return [media]
    files=[p for p in media.rglob('*') if p.is_file() and p.suffix.lower() in
           ('.mp4','.mkv','.mov','.m4v','.webm')]
    random.shuffle(files)
    return files

def movie(path, encoder):
    global resume_offset
    mode[0]='movie'
    atomic(loop_file,f'LOOP {completed_plays.get(path, 0)}')
    atomic(title_file,'On now:  '+(title_override or path.stem))
    atomic(rewind_label,'')
    atomic(rewind_stamp,'')
    print(f'[Prime Lite] Playing: {path.name} at {resume_offset:.1f}s',flush=True)
    if tape_wear:
        print(f'[Prime Lite] Tape wear: {completed_plays.get(path, 0)} completed plays',flush=True)
    duration_str=probe(path,'format=duration')
    try: duration=float(duration_str)
    except ValueError: duration=0
    runtime_stop=threading.Event()
    runtime_thread=None
    if show_runtime:
        def runtime_worker():
            started=time.monotonic()
            while not runtime_stop.is_set():
                s=int(resume_offset+time.monotonic()-started)
                hours, rem=divmod(s,3600)
                mins,secs=divmod(rem,60)
                atomic(runtime_file,f'PLAY  {hours:02}:{mins:02}:{secs:02}')
                runtime_stop.wait(1)
        runtime_thread=threading.Thread(target=runtime_worker,daemon=True)
        runtime_thread.start()
    try:
        byte_count=pump(transport_movie(path,resume_offset),encoder)
    except Exception:
        resume_offset+=transport_position
        raise
    finally:
        runtime_stop.set()
        if runtime_thread is not None:
            runtime_thread.join()
    return duration,byte_count

def rewind(path, duration, encoder):
    mode[0]='rewind'
    atomic(quote_file,'')
    atomic(title_file,'')
    atomic(runtime_file,'')
    atomic(rewind_label,'')
    atomic(rewind_stamp,'')
    total=rewind_secs+1.35
    print('[Prime Lite] << Rewind -> 00:00:00.000 -> Play >',flush=True)
    pump(transport_rewind(total,duration),encoder)

def run():
    global playlist, playlist_index, resume_offset
    root.mkdir(parents=True,exist_ok=True)
    if out.exists(): shutil.rmtree(out)
    out.mkdir(parents=True)
    (root/'channels.json').write_text(json.dumps([{'number':'03','name':'PRIME','path':'/Prime/index.m3u8'}])+'\n')
    if not playlist: playlist=source_files()
    files=playlist
    if not files: raise RuntimeError('No playable media found')
    server=Server((bind,port),Handler)
    thread=threading.Thread(target=server.serve_forever,daemon=True)
    thread.start()
    # Keep the demuxer's shared A/V timeline across transport boundaries.
    # Independent frame/sample counters accumulate gaps into permanent drift.
    graph=f'[0:v]fps={fps},format=yuv420p[base];'
    if logo.is_file():
        # Pipe input is source 0; image 1 is a static, endlessly looped overlay.
        graph+='[1:v]scale=55:-1,format=rgba[logo];[base][logo]overlay=24:H-h-58:shortest=0[decorated];'
        inputs=['-loop','1','-framerate',str(fps),'-i',str(logo)]
    else:
        graph+='[base]null[decorated];'
        inputs=[]
    layers=[draw(uptime_file,12,'24','20'),
            draw(loop_file,12,'w-tw-24','20'),
            draw(quote_file,12,'w-tw-24','h-th-56'),
            draw(title_file,11,'w-tw-24','h-th-37')]
    if show_runtime: layers.append(draw(runtime_file,12,'24','h-th-34'))
    layers.extend((draw(rewind_label,32,'(w-tw)/2','h/2-45',False),
                   draw(rewind_stamp,24,'(w-tw)/2','h/2+8',False)))
    graph+='[decorated]'+','.join(layers)
    if analog: graph+=','+analog_filter()
    graph+='[v]'
    cmd=[ffmpeg,'-nostdin','-hide_banner','-loglevel','warning',
         '-fflags','+genpts+discardcorrupt','-f','mpegts','-i','pipe:0',*inputs,
         '-filter_complex',graph,'-map','[v]','-map','0:a:0',
         '-af','aresample=48000:async=1000:first_pts=0',
         '-c:v','libx264','-preset','veryfast','-profile:v','main',
         '-b:v','1000k','-maxrate','1300k','-bufsize','2600k',
         '-g',str(fps*2),'-keyint_min',str(fps*2),'-sc_threshold','0',
         '-pix_fmt','yuv420p',
         '-c:a','aac','-b:a','96k','-ar','48000','-ac','2',
         '-f','hls','-hls_time','2','-hls_list_size','6',
         '-hls_start_number_source','epoch',
         '-hls_flags','delete_segments+omit_endlist+independent_segments+program_date_time',
         '-hls_delete_threshold','3','-hls_segment_filename',str(out/'seg_%d.ts'),
         str(out/'index.m3u8')]
    encoder=subprocess.Popen(cmd,stdin=subprocess.PIPE,stderr=log_file,bufsize=0)
    processes.append(encoder)
    print(f'[Prime Lite] http://{bind}:{port}/Prime/index.m3u8',flush=True)
    print(f'[Prime Lite] Font: {font or "FFmpeg default"}',flush=True)
    print(f'[Prime Lite] Continuous HLS encoder: PID {encoder.pid}',flush=True)
    print(f'[Prime Lite] Log: {log_path}',flush=True)
    try:
        while not stop.is_set():
            path=files[playlist_index]
            duration,amount=movie(path,encoder)
            if amount:
                completed_plays[path] = completed_plays.get(path, 0) + 1
                atomic(loop_file,f'LOOP {completed_plays[path]}')
            resume_offset=0.0
            playlist_index=(playlist_index+1)%len(files)
            if not amount:
                print(f'[Prime Lite] No transport data: {path}',file=sys.stderr)
                stop.wait(2)
            if len(files)==1 and amount:
                rewind(path,duration,encoder)
    finally:
        server.shutdown()
        server.server_close()
        encoder.stdin.close()
        reap(encoder)
        processes.remove(encoder)

def shutdown(signum,frame):
    stop.set()
    for proc in list(processes):
        if proc.poll() is None: proc.terminate()

signal.signal(signal.SIGINT,shutdown)
signal.signal(signal.SIGTERM,shutdown)
log_file=log_path.open('a')
def maintain_log():
    while not stop.wait(30):
        try:
            if os.fstat(log_file.fileno()).st_size > 8*1024*1024:
                with log_path.open('rb') as reader:
                    reader.seek(-1024*1024,os.SEEK_END)
                    tail=reader.read()
                log_path.with_name(log_path.name+'.previous').write_bytes(tail)
                os.ftruncate(log_file.fileno(),0)
        except OSError as exc:
            print(f'[Prime Lite] Log maintenance: {exc}',file=sys.stderr,flush=True)

threading.Thread(target=quote_worker,daemon=True).start()
uptime_thread=threading.Thread(target=uptime_worker,daemon=True)
uptime_thread.start()
threading.Thread(target=maintain_log,daemon=True).start()
try:
    while not stop.is_set():
        try:
            run()
        except Exception as exc:
            if not stop.is_set():
                message=f'[Prime Lite] {time.strftime("%Y-%m-%d %H:%M:%S")} ERROR: {exc}; retrying in 5 seconds'
                print(message,file=sys.stderr,flush=True)
                log_file.write(message+'\n')
                log_file.flush()
        finally:
            for proc in list(processes):
                reap(proc)
                processes.remove(proc)
        if not stop.is_set(): stop.wait(5)
finally:
    stop.set()
    uptime_thread.join()
    for proc in list(processes): reap(proc)
    log_file.close()
    shutil.rmtree(work,ignore_errors=True)
