#!/usr/bin/env bash
set -euo pipefail


# Configuration

PORT="${PORT:-8090}"
BIND_ADDR="${BIND_ADDR:-127.0.0.1}"
ROOT_HLS_DIR="${ROOT_HLS_DIR:-/tmp/broadcast-hls}"

FFMPEG="${FFMPEG:-ffmpeg}"
FFPROBE="${FFPROBE:-ffprobe}"

LOGO_PATH="${LOGO_PATH:-$HOME/Documents/Prime/logotype.png}"

OUTPUT_FPS="${OUTPUT_FPS:-24}"
VIDEO_BITRATE="${VIDEO_BITRATE:-1000k}"
VIDEO_MAXRATE="${VIDEO_MAXRATE:-1300k}"
VIDEO_BUFSIZE="${VIDEO_BUFSIZE:-2600k}"
AUDIO_BITRATE="${AUDIO_BITRATE:-96k}"

HLS_TIME="${HLS_TIME:-2}"
HLS_LIST_SIZE="${HLS_LIST_SIZE:-6}"
HLS_DELETE_THRESHOLD="${HLS_DELETE_THRESHOLD:-3}"

WATCHDOG_GRACE_SECONDS="${WATCHDOG_GRACE_SECONDS:-30}"
WATCHDOG_STALE_SECONDS="${WATCHDOG_STALE_SECONDS:-20}"
RESTART_DELAY_SECONDS="${RESTART_DELAY_SECONDS:-2}"

REWIND_SECONDS="${REWIND_SECONDS:-10}"
REWIND_BG_COLOR="${REWIND_BG_COLOR:-0x0000AA}"
REWIND_LABEL_FONT_SIZE="${REWIND_LABEL_FONT_SIZE:-32}"
REWIND_TIME_FONT_SIZE="${REWIND_TIME_FONT_SIZE:-24}"

DEFAULT_MEDIA_DIR="${DEFAULT_MEDIA_DIR:-$HOME/Documents/Will-broadcast/}"
DEFAULT_SIZE="${DEFAULT_SIZE:-640:360}"

QUOTE_BASE_URL="${QUOTE_BASE_URL:-https://weather.mborsare.workers.dev/prime/weather}"
QUOTE_REFRESH_SECONDS="${QUOTE_REFRESH_SECONDS:-15}"

DEFAULT_SCROLL_TEXT="${DEFAULT_SCROLL_TEXT:-}"
SCROLL_SPEED="${SCROLL_SPEED:-95}"

BUG_LOGO_WIDTH="${BUG_LOGO_WIDTH:-55}"
BUG_PAD="${BUG_PAD:-24}"
BUG_ROW_BOTTOM="${BUG_ROW_BOTTOM:-58}"
BUG_FONT_SIZE="${BUG_FONT_SIZE:-10}"
BUG_BOX_PAD="${BUG_BOX_PAD:-2}"

TICKER_BOTTOM="${TICKER_BOTTOM:-22}"
TICKER_FONT_SIZE="${TICKER_FONT_SIZE:-24}"
TICKER_BOX_PAD="${TICKER_BOX_PAD:-8}"

AD_REQUEST_FILE="${AD_REQUEST_FILE:-/tmp/broadcast-ad-request.txt}"
AD_NOW_FILE="${AD_NOW_FILE:-/tmp/broadcast-ad-now.txt}"
SLEEP_FILE="${SLEEP_FILE:-/tmp/broadcast-sleep.txt}"

SERVER_PID=""
QUOTE_PID=""
AD_PID=""
CHANNEL_PID=""
TIMER_PID=""

ENCODER_PID_FILE="$ROOT_HLS_DIR/encoder.pid"
BROADCAST_PID_FILE="$ROOT_HLS_DIR/broadcast.pid"

QUOTE_FILE="/tmp/broadcast-quotes-$$.txt"
NOW_PLAYING_FILE="/tmp/broadcast-now-playing-$$.txt"
SCROLL_FILE="/tmp/broadcast-scroll-$$.txt"
REWIND_TEXT_FILE="/tmp/broadcast-rewind-$$.txt"
STOP_FILE="/tmp/broadcast-stop-$$"


# Help

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat <<'EOF'
usage: broadcast [MEDIA_FILE_OR_DIR] [--now-playing TITLE]
       broadcast ad SECONDS FILE
       broadcast sleep MINUTES

With no media argument, plays ~/Documents/Will-broadcast.
Use --now-playing "Wargames" to show a title below the time and NQ quote.

Defaults:
  640x360
  24 fps
  2-second HLS segments
  10-second VCR rewind between loops of a single file

Set DEFAULT_MEDIA_DIR, DEFAULT_SIZE, OUTPUT_FPS, HLS_TIME, REWIND_SECONDS,
PORT, or BIND_ADDR in the environment to override these settings.
EOF
  exit 0
fi


# Sleep Timer

if [[ "${1:-}" == "sleep" ]]; then
  if [[ $# -ne 2 || ! "$2" =~ ^[0-9]+$ ]]; then
    echo "usage: broadcast sleep MINUTES" >&2
    exit 2
  fi

  if [[ ! -s "$BROADCAST_PID_FILE" ]]; then
    echo "No running broadcast found in $ROOT_HLS_DIR" >&2
    exit 1
  fi

  read -r broadcast_pid < "$BROADCAST_PID_FILE"

  if ! [[ "$broadcast_pid" =~ ^[0-9]+$ ]]; then
    echo "Invalid broadcast PID file: $BROADCAST_PID_FILE" >&2
    exit 1
  fi

  broadcast_is_running() {
    local command_line

    command_line="$(ps -p "$broadcast_pid" -o args= 2>/dev/null || true)"

    [[ "$command_line" =~ (^|[[:space:]/])broadcast([[:space:]]|$) ]]
  }

  if ! broadcast_is_running; then
    echo "Broadcast PID $broadcast_pid is no longer running" >&2
    exit 1
  fi

  format_remaining() {
    local total="$1"
    local days=$((total / 86400))
    local hours=$(((total % 86400) / 3600))
    local minutes=$(((total % 3600) / 60))
    local seconds=$((total % 60))

    if (( days > 0 )); then
      printf '%dd %02dh %02dm %02ds' \
        "$days" "$hours" "$minutes" "$seconds"
    elif (( hours > 0 )); then
      printf '%dh %02dm %02ds' \
        "$hours" "$minutes" "$seconds"
    elif (( minutes > 0 )); then
      printf '%dm %02ds' \
        "$minutes" "$seconds"
    else
      printf '%ds' "$seconds"
    fi
  }

  trap 'rm -f "$SLEEP_FILE"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  end_epoch=$(( $(date +%s) + 10#$2 * 60 ))
  last_text=""

  while (( $(date +%s) < end_epoch )); do
    if ! broadcast_is_running; then
      echo "Broadcast stopped before the sleep timer ended" >&2
      exit 1
    fi

    remaining=$((end_epoch - $(date +%s)))

    if (( remaining <= 60 )); then
      current_text="sleep $(format_remaining "$remaining")"
    else
      current_text="sleep $(((remaining + 59) / 60))m"
    fi

    if [[ "$current_text" != "$last_text" ]]; then
      printf '%s\n' "$current_text" > "$SLEEP_FILE"
      last_text="$current_text"
    fi

    sleep 1
  done

  if broadcast_is_running; then
    kill "$broadcast_pid"
  fi

  exit 0
fi


# Ad Trigger

run_ad_command=0

if [[ "$(basename "$0")" == "broadcastad" ]]; then
  run_ad_command=1
fi

if [[ "${1:-}" == "ad" ]]; then
  run_ad_command=1
  shift
fi

if [[ "$run_ad_command" -eq 1 ]]; then
  if [[ $# -lt 2 ]]; then
    echo "usage: broadcast ad SECONDS FILE" >&2
    echo "   or: broadcastad SECONDS FILE" >&2
    exit 1
  fi

  delay="$1"
  ad_file="$2"

  if ! [[ "$delay" =~ ^[0-9]+$ ]]; then
    echo "Delay must be seconds, like: 45" >&2
    exit 1
  fi

  ad_path="$(
    python3 - "$ad_file" <<'PY'
import sys
from pathlib import Path

p = Path(sys.argv[1]).expanduser()

try:
    print(str(p.resolve(strict=True)))
except FileNotFoundError:
    raise SystemExit(2)
PY
  )" || {
    echo "No such ad file: $ad_file" >&2
    exit 1
  }

  tmp="${AD_REQUEST_FILE}.$$"

  printf "%s\t%s\n" "$delay" "$ad_path" > "$tmp"
  mv "$tmp" "$AD_REQUEST_FILE"

  echo "Ad queued: break in ${delay}s -> $ad_path"

  exit 0
fi


# Arguments

NOW_PLAYING_TITLE=""
MEDIA_PATH=""

while (( $# > 0 )); do
  case "$1" in
    --now-playing)
      if (( $# < 2 )); then
        echo "--now-playing requires a title" >&2
        exit 2
      fi

      NOW_PLAYING_TITLE="$2"
      shift 2
      ;;

    --)
      shift

      if (( $# != 1 )) || [[ -n "$MEDIA_PATH" ]]; then
        echo "usage: broadcast [MEDIA_FILE_OR_DIR] [--now-playing TITLE]" >&2
        exit 2
      fi

      MEDIA_PATH="$1"
      shift
      ;;

    -*)
      echo "Unknown option: $1" >&2
      exit 2
      ;;

    *)
      if [[ -n "$MEDIA_PATH" ]]; then
        echo "usage: broadcast [MEDIA_FILE_OR_DIR] [--now-playing TITLE]" >&2
        exit 2
      fi

      MEDIA_PATH="$1"
      shift
      ;;
  esac
done

MEDIA_PATH="${MEDIA_PATH:-$DEFAULT_MEDIA_DIR}"

if [[ ! -e "$MEDIA_PATH" ]]; then
  echo "No such file or folder: $MEDIA_PATH" >&2
  exit 1
fi


# Helpers

set_scroll_text() {
  local text="${1:-}"

  if [[ -n "$text" ]]; then
    printf "%s\n" "$text" > "$SCROLL_FILE"
  else
    : > "$SCROLL_FILE"
  fi
}

set_break_countdown_text() {
  local remaining="$1"

  if [[ -n "$DEFAULT_SCROLL_TEXT" ]]; then
    set_scroll_text "COMMERCIAL BREAK IN ${remaining}  //  ${DEFAULT_SCROLL_TEXT}"
  else
    set_scroll_text "COMMERCIAL BREAK IN ${remaining}"
  fi
}

kill_encoder() {
  local pid=""

  if [[ -s "$ENCODER_PID_FILE" ]]; then
    read -r pid < "$ENCODER_PID_FILE" || true

    if [[ "$pid" =~ ^[0-9]+$ ]]; then
      kill "$pid" 2>/dev/null || true

      local attempt

      for attempt in {1..50}; do
        [[ ! -e "$ENCODER_PID_FILE" ]] && return 0
        sleep 0.1
      done

      kill -9 "$pid" 2>/dev/null || true
    fi
  fi
}


# Runtime

require_runtime() {
  local missing=()
  local cmd

  for cmd in "$FFMPEG" "$FFPROBE" python3 curl; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      missing+=("$cmd")
    fi
  done

  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Missing required app(s): ${missing[*]}" >&2
    exit 1
  fi

  if [[ ! -f "$LOGO_PATH" ]]; then
    echo "[warn] Logo not found, continuing without logo: $LOGO_PATH" >&2
  fi
}


# Cleanup

cleanup() {
  local status="$1"

  touch "$STOP_FILE"

  echo -e "\n\033[0;31m[!] Cleanup...\033[0m"

  kill_encoder

  local pid

  for pid in \
    "$CHANNEL_PID" \
    "$AD_PID" \
    "$QUOTE_PID" \
    "$SERVER_PID" \
    "$TIMER_PID"
  do
    if [[ -n "$pid" ]]; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
    fi
  done

  rm -rf "$ROOT_HLS_DIR"

  rm -f \
    "$STOP_FILE" \
    "$QUOTE_FILE" \
    "$NOW_PLAYING_FILE" \
    "$SCROLL_FILE" \
    "$REWIND_TEXT_FILE" \
    "$AD_NOW_FILE"

  echo "[+] Broadcast stopped."

  return "$status"
}


# Web Server

start_server() {
  echo "[*] Starting Web Server on $BIND_ADDR:$PORT..."

  BIND_ADDR="$BIND_ADDR" \
  PORT="$PORT" \
  ROOT_HLS_DIR="$ROOT_HLS_DIR" \
  python3 - >/tmp/broadcast-server.log 2>&1 <<'PY' &
import http.server
import os

BIND_ADDR = os.environ["BIND_ADDR"]
PORT = int(os.environ["PORT"])
ROOT = os.environ["ROOT_HLS_DIR"]


class HLSHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=ROOT, **kwargs)

    def guess_type(self, path):
        path = str(path)

        if path.endswith(".m3u8"):
            return "application/vnd.apple.mpegurl"

        if path.endswith(".ts"):
            return "video/mp2t"

        if path.endswith(".json"):
            return "application/json"

        return super().guess_type(path)

    def end_headers(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "no-cache")
        super().end_headers()

    def log_message(self, fmt, *args):
        pass


class Server(http.server.ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True


Server((BIND_ADDR, PORT), HLSHandler).serve_forever()
PY

  SERVER_PID="$!"
}

wait_for_server() {
  local check_addr="$BIND_ADDR"

  if [[ "$check_addr" == "0.0.0.0" || "$check_addr" == "::" ]]; then
    check_addr="127.0.0.1"
  fi

  local url="http://$check_addr:$PORT/channels.json"
  local i

  for i in {1..50}; do
    if curl -sf --max-time 1 "$url" >/dev/null 2>&1; then
      return 0
    fi

    if [[ -n "$SERVER_PID" ]] &&
       ! kill -0 "$SERVER_PID" 2>/dev/null
    then
      echo "[error] Web server exited before it was reachable." >&2
      cat /tmp/broadcast-server.log >&2 2>/dev/null || true
      exit 1
    fi

    sleep 0.1
  done

  echo "[error] Web server did not become reachable at $url" >&2
  cat /tmp/broadcast-server.log >&2 2>/dev/null || true

  exit 1
}


# Quotes

fetch_quote() {
  local symbol="$1"
  local url="$QUOTE_BASE_URL/$symbol"
  local out=""

  out="$(
    curl -sf --max-time 5 "$url" 2>/dev/null |
    python3 -c '
import json
import math
import sys

try:
    d = json.load(sys.stdin)
    price = None

    if isinstance(d, dict):
        for key in ("price", "last", "mark", "close", "c"):
            if d.get(key) is not None:
                price = d[key]
                break

        series = (
            d.get("priceSeries")
            or d.get("prices")
            or d.get("data")
            or []
        )

        if price is None and isinstance(series, list) and series:
            latest = series[-1]

            if isinstance(latest, dict):
                for key in ("last", "price", "mark", "close", "c"):
                    if latest.get(key) is not None:
                        price = latest[key]
                        break

                if (
                    price is None
                    and latest.get("hi") is not None
                    and latest.get("lo") is not None
                ):
                    price = (
                        float(latest["hi"])
                        + float(latest["lo"])
                    ) / 2
            else:
                price = latest

    if price is None:
        raise ValueError("missing price")

    value = float(price)

    if not math.isfinite(value):
        raise ValueError("bad price")

    print(str(math.trunc(value)))

except Exception:
    print("-----")
' 2>/dev/null || true
  )"

  if [[ -z "$out" ]]; then
    out="-----"
  fi

  printf "%s" "$out"
}

start_quote_file() {
  (
    local nq_now="-----"
    local next_quote_refresh=0
    local now_epoch=""
    local current_time=""

    while [[ ! -f "$STOP_FILE" ]]; do
      now_epoch="$(date +%s)"
      current_time="$(date '+%H:%M')"

      if [[ "$now_epoch" -ge "$next_quote_refresh" ]]; then
        nq_now="$(fetch_quote NQ)"
        next_quote_refresh=$((now_epoch + QUOTE_REFRESH_SECONDS))
      fi

      printf "%s  NQ %s\n" \
        "$current_time" \
        "$nq_now" \
        > "$QUOTE_FILE"

      sleep 1
    done
  ) &

  QUOTE_PID="$!"
}


# Commercial Breaks

start_ad_watcher() {
  (
    while [[ ! -f "$STOP_FILE" ]]; do
      if [[ -f "$AD_NOW_FILE" ]]; then
        sleep 1
        continue
      fi

      if [[ ! -s "$AD_REQUEST_FILE" ]]; then
        sleep 1
        continue
      fi

      local delay=""
      local ad_path=""

      IFS=$'\t' read -r delay ad_path < "$AD_REQUEST_FILE" || true
      rm -f "$AD_REQUEST_FILE"

      if ! [[ "$delay" =~ ^[0-9]+$ ]]; then
        delay="0"
      fi

      if [[ -z "$ad_path" || ! -f "$ad_path" ]]; then
        set_scroll_text "$DEFAULT_SCROLL_TEXT"
        continue
      fi

      local remaining="$delay"

      while [[ "$remaining" -gt 0 && ! -f "$STOP_FILE" ]]; do
        set_break_countdown_text "$remaining"

        sleep 1

        remaining=$((remaining - 1))
      done

      if [[ -f "$STOP_FILE" ]]; then
        break
      fi

      printf "%s\n" "$ad_path" > "$AD_NOW_FILE"

      set_scroll_text "COMMERCIAL BREAK"

      echo -e \
        "\033[0;35m[ad]\033[0m Starting commercial: $ad_path"

      kill_encoder

      sleep 1
    done
  ) &

  AD_PID="$!"
}


# Channel Manifest

write_channel_manifest() {
  local manifest="$ROOT_HLS_DIR/channels.json"

  python3 - "$manifest" <<'PY'
import json
import sys

manifest = sys.argv[1]

out = [
    {
        "number": "03",
        "name": "PRIME",
        "path": "/Prime/index.m3u8",
    }
]

with open(manifest, "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2)
    f.write("\n")
PY
}


# Media Discovery

list_media_files() {
  local media_path="$1"

  python3 - "$media_path" "$FFPROBE" <<'PY'
import random
import signal
import subprocess
import sys

from pathlib import Path


signal.signal(signal.SIGPIPE, signal.SIG_DFL)

media_path = Path(sys.argv[1]).expanduser()
ffprobe = sys.argv[2]

exts = {
    ".mp4",
    ".mkv",
    ".mov",
    ".m4v",
    ".webm",
}

if media_path.is_file():
    candidates = [media_path.resolve()]

elif media_path.is_dir():
    candidates = sorted(
        (
            p.resolve()
            for p in media_path.rglob("*")
            if p.is_file()
            and p.suffix.lower() in exts
            and not p.name.startswith("._")
        ),
        key=lambda p: str(p).lower(),
    )

    random.shuffle(candidates)

else:
    raise SystemExit(
        f"No such file or folder: {media_path}"
    )


good_count = 0

for path in candidates:
    try:
        result = subprocess.run(
            [
                ffprobe,
                "-v",
                "error",
                "-select_streams",
                "v:0",
                "-show_entries",
                "stream=codec_type",
                "-of",
                "csv=p=0",
                str(path),
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=8,
        )

        if (
            result.returncode == 0
            and "video" in result.stdout
        ):
            good_count += 1

            sys.stdout.buffer.write(
                str(path).encode("utf-8") + b"\0"
            )

            sys.stdout.buffer.flush()

        else:
            print(
                f"[skip bad media] {path}",
                file=sys.stderr,
            )

    except Exception:
        print(
            f"[skip bad media] {path}",
            file=sys.stderr,
        )

if not good_count:
    raise SystemExit(
        f"No playable media files found in {media_path}"
    )
PY
}


# Video Filter

build_video_filter() {
  local width="$1"
  local height="$2"

  local font_path=""
  local font_arg=""
  local v_filter=""

  local quote_row_bottom="$BUG_ROW_BOTTOM"
  local quote_output="bugged"

  if [[ -n "$NOW_PLAYING_TITLE" ]]; then
    quote_row_bottom=$((BUG_ROW_BOTTOM + BUG_FONT_SIZE + 6))
    quote_output="quoted"
  fi

  if command -v fc-match >/dev/null 2>&1; then
    font_path="$(
      fc-match \
        -f '%{file}\n' \
        'ComicShannsMono Nerd Font' \
        2>/dev/null |
      head -n 1 ||
      true
    )"
  fi

  if [[ -z "$font_path" || ! -f "$font_path" ]]; then
    font_path="/usr/share/fonts/OTF/ComicShannsMonoNerdFont-Regular.otf"
  fi

  if [[ -f "$font_path" ]]; then
    font_arg="fontfile='$font_path':"
  fi

  v_filter="fps=$OUTPUT_FPS,"
  v_filter+="setsar=1,"
  v_filter+="scale=$width:$height:"
  v_filter+="force_original_aspect_ratio=decrease:"
  v_filter+="force_divisible_by=2,"
  v_filter+="pad=$width:$height:(ow-iw)/2:(oh-ih)/2,"
  v_filter+="setsar=1,"
  v_filter+="format=yuv420p[main];"

  # Logo

  if [[ -f "$LOGO_PATH" ]]; then
    v_filter+="movie='$LOGO_PATH',"
    v_filter+="scale=$BUG_LOGO_WIDTH:-1[logo];"

    v_filter+="[main][logo]"
    v_filter+="overlay="
    v_filter+="$BUG_PAD:"
    v_filter+="H-h-$quote_row_bottom"
    v_filter+="[bugbase];"
  else
    v_filter+="[main]null[bugbase];"
  fi

  # Time And NQ

  v_filter+="[bugbase]drawtext="
  v_filter+="$font_arg"
  v_filter+="textfile='$QUOTE_FILE':"
  v_filter+="reload=1:"
  v_filter+="x=W-tw-$BUG_PAD:"
  v_filter+="y=H-th-$quote_row_bottom:"
  v_filter+="fontsize=$BUG_FONT_SIZE:"
  v_filter+="fontcolor=white:"
  v_filter+="box=1:"
  v_filter+="boxcolor=black@0.50:"
  v_filter+="boxborderw=$BUG_BOX_PAD"
  v_filter+="[$quote_output];"

  # Now Playing

  if [[ -n "$NOW_PLAYING_TITLE" ]]; then
    v_filter+="[quoted]drawtext="
    v_filter+="$font_arg"
    v_filter+="textfile='$NOW_PLAYING_FILE':"
    v_filter+="x=W-tw-$BUG_PAD:"
    v_filter+="y=H-th-$BUG_ROW_BOTTOM:"
    v_filter+="fontsize=$BUG_FONT_SIZE:"
    v_filter+="fontcolor=white:"
    v_filter+="box=1:"
    v_filter+="boxcolor=black@0.50:"
    v_filter+="boxborderw=$BUG_BOX_PAD"
    v_filter+="[bugged];"
  fi

  # Ticker

  v_filter+="[bugged]drawtext="
  v_filter+="$font_arg"
  v_filter+="textfile='$SCROLL_FILE':"
  v_filter+="reload=1:"
  v_filter+="x=W-mod(t*$SCROLL_SPEED\\,W+tw):"
  v_filter+="y=H-th-$TICKER_BOTTOM:"
  v_filter+="fontsize=$TICKER_FONT_SIZE:"
  v_filter+="fontcolor=white:"
  v_filter+="box=1:"
  v_filter+="boxcolor=black@0.55:"
  v_filter+="boxborderw=$TICKER_BOX_PAD"

  printf "%s" "$v_filter"
}


# Rewind Helpers

probe_media_duration_ms() {
  local media_file="$1"

  "$FFPROBE" \
    -v error \
    -show_entries format=duration \
    -of default=noprint_wrappers=1:nokey=1 \
    "$media_file" |
  python3 -c '
import math
import sys

try:
    value = float(sys.stdin.read().strip())
    if not math.isfinite(value) or value < 0:
        raise ValueError
    print(int(round(value * 1000)))
except Exception:
    print(0)
'
}

format_rewind_time() {
  local total_ms="$1"

  python3 - "$total_ms" <<'PY'
import sys

try:
    total_ms = max(0, int(sys.argv[1]))
except Exception:
    total_ms = 0

hours, rem = divmod(total_ms, 3_600_000)
minutes, rem = divmod(rem, 60_000)
seconds, millis = divmod(rem, 1_000)

print(f"{hours:02d}:{minutes:02d}:{seconds:02d}.{millis:03d}")
PY
}


# HLS Encoder

run_ffmpeg_hls() {
  local media_file="$1"
  local hls_dir="$2"
  local v_filter="$3"
  local loop_mode="$4"

  local loop_args=()

  if [[ "$loop_mode" == "loop" ]]; then
    loop_args=(-stream_loop -1)
  fi

  "$FFMPEG" \
    -nostdin \
    -hide_banner \
    -loglevel warning \
    -re \
    "${loop_args[@]}" \
    -fflags +genpts+discardcorrupt \
    -err_detect ignore_err \
    -i "$media_file" \
    -map 0:v:0 \
    -map 0:a? \
    -vf "$v_filter" \
    -c:v libx264 \
    -preset veryfast \
    -profile:v main \
    -b:v "$VIDEO_BITRATE" \
    -maxrate "$VIDEO_MAXRATE" \
    -bufsize "$VIDEO_BUFSIZE" \
    -g "$((OUTPUT_FPS * HLS_TIME))" \
    -keyint_min "$((OUTPUT_FPS * HLS_TIME))" \
    -sc_threshold 0 \
    -pix_fmt yuv420p \
    -c:a aac \
    -b:a "$AUDIO_BITRATE" \
    -ar 44100 \
    -ac 2 \
    -dn \
    -sn \
    -f hls \
    -hls_time "$HLS_TIME" \
    -hls_list_size "$HLS_LIST_SIZE" \
    -hls_start_number_source epoch \
    -hls_flags \
      delete_segments+omit_endlist+program_date_time+independent_segments \
    -hls_delete_threshold "$HLS_DELETE_THRESHOLD" \
    -hls_segment_filename "$hls_dir/seg_%d.ts" \
    "$hls_dir/index.m3u8" &

  local encoder_pid="$!"
  local status=0
  local watchdog_pid=""

  printf '%s\n' "$encoder_pid" > "$ENCODER_PID_FILE"

  (
    local started=""
    local now=""
    local mtime=""
    local age=""

    started="$(date +%s)"

    while kill -0 "$encoder_pid" 2>/dev/null &&
          [[ ! -f "$STOP_FILE" ]]
    do
      sleep 5

      now="$(date +%s)"

      if (( now - started < WATCHDOG_GRACE_SECONDS )); then
        continue
      fi

      if [[ -f "$hls_dir/index.m3u8" ]]; then
        mtime="$(
          stat -c %Y \
            "$hls_dir/index.m3u8" \
            2>/dev/null ||
          echo 0
        )"

        age=$((now - mtime))

        if (( age > WATCHDOG_STALE_SECONDS )); then
          echo -e \
            "\033[0;31m[watchdog]\033[0m HLS stale for ${age}s; restarting encoder." \
            >&2

          kill "$encoder_pid" 2>/dev/null || true

          sleep 2

          kill -9 "$encoder_pid" 2>/dev/null || true

          break
        fi

      else
        echo -e \
          "\033[0;31m[watchdog]\033[0m Encoder produced no HLS after ${WATCHDOG_GRACE_SECONDS}s; restarting." \
          >&2

        kill "$encoder_pid" 2>/dev/null || true

        sleep 2

        kill -9 "$encoder_pid" 2>/dev/null || true

        break
      fi
    done
  ) &

  watchdog_pid="$!"

  wait "$encoder_pid" || status="$?"

  kill "$watchdog_pid" 2>/dev/null || true
  wait "$watchdog_pid" 2>/dev/null || true

  rm -f "$ENCODER_PID_FILE"

  return "$status"
}


run_rewind_hls() {
  local media_file="$1"
  local hls_dir="$2"
  local width="$3"
  local height="$4"

  local duration_ms="0"
  local font_path=""
  local font_arg=""
  local rewind_filter=""
  local encoder_pid=""
  local updater_pid=""
  local status=0

  duration_ms="$(
    probe_media_duration_ms "$media_file" 2>/dev/null ||
    echo 0
  )"

  if ! [[ "$duration_ms" =~ ^[0-9]+$ ]]; then
    duration_ms="0"
  fi

  printf '%s\n' \
    "$(format_rewind_time "$duration_ms")" \
    > "$REWIND_TEXT_FILE"

  if command -v fc-match >/dev/null 2>&1; then
    font_path="$(
      fc-match \
        -f '%{file}\n' \
        'ComicShannsMono Nerd Font' \
        2>/dev/null |
      head -n 1 ||
      true
    )"
  fi

  if [[ -z "$font_path" || ! -f "$font_path" ]]; then
    font_path="/usr/share/fonts/OTF/ComicShannsMonoNerdFont-Regular.otf"
  fi

  if [[ -f "$font_path" ]]; then
    font_arg="fontfile='$font_path':"
  fi

  rewind_filter="drawtext=${font_arg}"
  rewind_filter+="text='<< Rewind':"
  rewind_filter+="x=(w-text_w)/2:"
  rewind_filter+="y=(h/2)-42:"
  rewind_filter+="fontsize=$REWIND_LABEL_FONT_SIZE:"
  rewind_filter+="fontcolor=white,"
  rewind_filter+="drawtext=${font_arg}"
  rewind_filter+="textfile='$REWIND_TEXT_FILE':"
  rewind_filter+="reload=1:"
  rewind_filter+="x=(w-text_w)/2:"
  rewind_filter+="y=(h/2)+8:"
  rewind_filter+="fontsize=$REWIND_TIME_FONT_SIZE:"
  rewind_filter+="fontcolor=white"

  echo -e \
    "\033[0;34m[Prime]\033[0m << Rewind (${REWIND_SECONDS}s)"

  "$FFMPEG" \
    -nostdin \
    -hide_banner \
    -loglevel warning \
    -re \
    -f lavfi \
    -i "color=c=$REWIND_BG_COLOR:s=${width}x${height}:r=$OUTPUT_FPS" \
    -re \
    -f lavfi \
    -i "anullsrc=r=44100:cl=stereo" \
    -map 0:v:0 \
    -map 1:a:0 \
    -vf "$rewind_filter" \
    -t "$REWIND_SECONDS" \
    -c:v libx264 \
    -preset veryfast \
    -profile:v main \
    -b:v "$VIDEO_BITRATE" \
    -maxrate "$VIDEO_MAXRATE" \
    -bufsize "$VIDEO_BUFSIZE" \
    -g "$((OUTPUT_FPS * HLS_TIME))" \
    -keyint_min "$((OUTPUT_FPS * HLS_TIME))" \
    -sc_threshold 0 \
    -pix_fmt yuv420p \
    -c:a aac \
    -b:a "$AUDIO_BITRATE" \
    -ar 44100 \
    -ac 2 \
    -f hls \
    -hls_time "$HLS_TIME" \
    -hls_list_size "$HLS_LIST_SIZE" \
    -hls_start_number_source epoch \
    -hls_flags \
      delete_segments+omit_endlist+program_date_time+independent_segments \
    -hls_delete_threshold "$HLS_DELETE_THRESHOLD" \
    -hls_segment_filename "$hls_dir/seg_%d.ts" \
    "$hls_dir/index.m3u8" &

  encoder_pid="$!"
  printf '%s\n' "$encoder_pid" > "$ENCODER_PID_FILE"

  python3 - \
    "$REWIND_TEXT_FILE" \
    "$duration_ms" \
    "$REWIND_SECONDS" \
    "$STOP_FILE" \
    "$AD_NOW_FILE" <<'PY' &
import os
import sys
import time

text_path = sys.argv[1]
duration_ms = max(0, int(sys.argv[2]))
rewind_seconds = max(0.001, float(sys.argv[3]))
stop_path = sys.argv[4]
ad_path = sys.argv[5]


def format_time(total_ms):
    total_ms = max(0, int(total_ms))
    hours, rem = divmod(total_ms, 3_600_000)
    minutes, rem = divmod(rem, 60_000)
    seconds, millis = divmod(rem, 1_000)
    return f"{hours:02d}:{minutes:02d}:{seconds:02d}.{millis:03d}"


def write_atomic(value):
    tmp = f"{text_path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(format_time(value) + "\n")
    os.replace(tmp, text_path)


started = time.monotonic()
write_atomic(duration_ms)

while True:
    if os.path.exists(stop_path) or os.path.exists(ad_path):
        break

    elapsed = time.monotonic() - started
    fraction = min(1.0, elapsed / rewind_seconds)
    remaining = round(duration_ms * (1.0 - fraction))
    write_atomic(remaining)

    if fraction >= 1.0:
        break

    time.sleep(0.025)

write_atomic(0)
PY

  updater_pid="$!"

  wait "$encoder_pid" || status="$?"

  kill "$updater_pid" 2>/dev/null || true
  wait "$updater_pid" 2>/dev/null || true

  rm -f "$ENCODER_PID_FILE"

  return "$status"
}


# Channel Supervisor

start_channel() {
  local width="${DEFAULT_SIZE%%:*}"
  local height="${DEFAULT_SIZE##*:}"
  local hls_dir="$ROOT_HLS_DIR/Prime"
  local v_filter=""

  mkdir -p "$hls_dir"

  v_filter="$(
    build_video_filter \
      "$width" \
      "$height"
  )"

  echo -e \
    "\033[0;34m[Prime]\033[0m Starting channel supervisor..."

  echo "source: $MEDIA_PATH"

  (
    while [[ ! -f "$STOP_FILE" ]]; do

      # Commercial

      if [[ -s "$AD_NOW_FILE" ]]; then
        local ad_path=""

        ad_path="$(
          cat "$AD_NOW_FILE" 2>/dev/null || true
        )"

        if [[ -n "$ad_path" && -f "$ad_path" ]]; then
          set_scroll_text "COMMERCIAL BREAK"

          echo -e \
            "\033[0;35m[Prime]\033[0m Playing ad: $ad_path"

          run_ffmpeg_hls \
            "$ad_path" \
            "$hls_dir" \
            "$v_filter" \
            "once" ||
          true
        fi

        rm -f "$AD_NOW_FILE"

        set_scroll_text "$DEFAULT_SCROLL_TEXT"

        echo -e \
          "\033[0;35m[Prime]\033[0m Returning to programming..."

        continue
      fi

      # Single File

      if [[ -f "$MEDIA_PATH" ]]; then
        local status=0
        local rewind_status=0

        echo -e \
          "\033[0;34m[Prime]\033[0m Now playing: $MEDIA_PATH"

        run_ffmpeg_hls \
          "$MEDIA_PATH" \
          "$hls_dir" \
          "$v_filter" \
          "once" ||
        status="$?"

        [[ -f "$STOP_FILE" ]] && break
        [[ -s "$AD_NOW_FILE" ]] && continue

        if (( status != 0 )); then
          echo -e \
            "\033[0;31m[Prime]\033[0m Encoder exited (status $status). Restarting in ${RESTART_DELAY_SECONDS}s..."

          sleep "$RESTART_DELAY_SECONDS"
          continue
        fi

        rewind_status=0

        run_rewind_hls \
          "$MEDIA_PATH" \
          "$hls_dir" \
          "$width" \
          "$height" ||
        rewind_status="$?"

        [[ -f "$STOP_FILE" ]] && break
        [[ -s "$AD_NOW_FILE" ]] && continue

        if (( rewind_status != 0 )); then
          echo -e \
            "\033[0;33m[Prime]\033[0m Rewind screen exited (status $rewind_status); restarting movie." \
            >&2
        else
          echo -e \
            "\033[0;34m[Prime]\033[0m Rewind complete. Restarting movie..."
        fi

        continue
      fi

      # Media Folder

      local media_file=""
      local status=0
      local media_count=0

      while IFS= read -r -d '' media_file; do
        ((media_count += 1))

        [[ -f "$STOP_FILE" ]] && break
        [[ -s "$AD_NOW_FILE" ]] && break

        echo -e \
          "\033[0;34m[Prime]\033[0m Now playing: $media_file"

        status=0

        run_ffmpeg_hls \
          "$media_file" \
          "$hls_dir" \
          "$v_filter" \
          "once" ||
        status="$?"

        [[ -f "$STOP_FILE" ]] && break
        [[ -s "$AD_NOW_FILE" ]] && break

        if (( status != 0 )); then
          echo -e \
            "\033[0;33m[Prime]\033[0m Media failed (status $status); skipping: $media_file" \
            >&2

          sleep 1
        fi

      done < <(
        list_media_files "$MEDIA_PATH"
      )

      if (( media_count == 0 )); then
        echo -e \
          "\033[0;31m[Prime]\033[0m No playable media. Retrying in 10s..." \
          >&2

        sleep 10
      fi
    done
  ) &

  CHANNEL_PID="$!"
}


# Validation

if ! [[ "$OUTPUT_FPS" =~ ^[0-9]+$ ]] ||
   (( OUTPUT_FPS < 24 ))
then
  echo "OUTPUT_FPS must be an integer of at least 24" >&2
  exit 2
fi

if ! [[ "$HLS_TIME" =~ ^[0-9]+$ ]] ||
   (( HLS_TIME < 1 ))
then
  echo "HLS_TIME must be a positive integer" >&2
  exit 2
fi

if ! [[ "$REWIND_SECONDS" =~ ^[0-9]+$ ]] ||
   (( REWIND_SECONDS < 1 ))
then
  echo "REWIND_SECONDS must be a positive integer" >&2
  exit 2
fi

require_runtime


# Port Cleanup

if command -v fuser >/dev/null 2>&1; then
  if fuser "$PORT/tcp" >/dev/null 2>&1; then
    echo "[!] Clearing stale listener on $BIND_ADDR:$PORT..."

    fuser -k "$PORT/tcp" >/dev/null 2>&1 || true

    for _ in {1..20}; do
      if ! fuser "$PORT/tcp" >/dev/null 2>&1; then
        break
      fi

      sleep 0.1
    done
  fi
fi


# Port Check

python3 - "$BIND_ADDR" "$PORT" <<'PY'
import socket
import sys

address = sys.argv[1]
port = int(sys.argv[2])

family = (
    socket.AF_INET6
    if ":" in address
    else socket.AF_INET
)

try:
    with socket.socket(
        family,
        socket.SOCK_STREAM,
    ) as sock:
        sock.setsockopt(
            socket.SOL_SOCKET,
            socket.SO_REUSEADDR,
            1,
        )

        sock.bind(
            (
                address,
                port,
            )
        )

except OSError as exc:
    raise SystemExit(
        f"Cannot bind {address}:{port}: {exc}"
    )
PY


# Existing Broadcast

if [[ -s "$BROADCAST_PID_FILE" ]]; then
  read -r previous_pid \
    < "$BROADCAST_PID_FILE" || true

  if [[ "$previous_pid" =~ ^[0-9]+$ ]] &&
     kill -0 "$previous_pid" 2>/dev/null
  then
    echo \
      "Broadcast is already running (PID $previous_pid)" \
      >&2

    exit 1
  fi
fi


# Working Directory

rm -rf "$ROOT_HLS_DIR"
mkdir -p "$ROOT_HLS_DIR"

printf '%s\n' "$$" > "$BROADCAST_PID_FILE"

trap 'cleanup $?' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

rm -f \
  "$STOP_FILE" \
  "$QUOTE_FILE" \
  "$NOW_PLAYING_FILE" \
  "$SCROLL_FILE" \
  "$REWIND_TEXT_FILE" \
  "$AD_NOW_FILE"

printf "%s\n" \
  "$(date '+%H:%M')  NQ -----" \
  > "$QUOTE_FILE"

if [[ -n "$NOW_PLAYING_TITLE" ]]; then
  printf 'Now playing: %s\n' \
    "${NOW_PLAYING_TITLE//$'\n'/ }" \
    > "$NOW_PLAYING_FILE"
fi

set_scroll_text "$DEFAULT_SCROLL_TEXT"


# Start Services

write_channel_manifest

start_server
wait_for_server

start_quote_file
start_ad_watcher
start_channel


# Wait For Stream

echo "[*] Initializing streams..."

ready=0

for _ in {1..120}; do
  if [[ -f "$ROOT_HLS_DIR/Prime/index.m3u8" ]]; then
    ready=1
    break
  fi

  sleep 0.5
done

if [[ "$ready" -ne 1 ]]; then
  echo \
    "[error] Prime never produced index.m3u8" \
    >&2

  exit 1
fi


# Live

echo -e \
  "\n\033[1;32m------------------------------------------------\033[0m"

echo -e \
  "\033[1;32m    PRIME BROADCAST LIVE \033[0m"

echo -e \
  "\033[1;32m------------------------------------------------\033[0m"

echo -e \
  "\033[1mManifest:\033[0m http://localhost:$PORT/channels.json"

echo ""

echo "Source: $MEDIA_PATH"
echo "http://localhost:$PORT/Prime/index.m3u8"

echo ""

echo "Ad trigger:"
echo "./$(basename "$0") ad 45 /path/to/foo.mp4"

echo "Sleep timer:"
echo "./$(basename "$0") sleep 90"

echo ""
echo "Press Ctrl+C to stop."


# Main Loop

sleep 604800 &
TIMER_PID="$!"

while kill -0 "$TIMER_PID" 2>/dev/null; do

  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    echo -e \
      "\033[0;31m[server]\033[0m Web server died; restarting..." \
      >&2

    start_server
    wait_for_server
  fi

  if ! kill -0 "$QUOTE_PID" 2>/dev/null; then
    echo -e \
      "\033[0;31m[quotes]\033[0m Quote worker died; restarting..." \
      >&2

    start_quote_file
  fi

  if ! kill -0 "$AD_PID" 2>/dev/null; then
    echo -e \
      "\033[0;31m[ads]\033[0m Ad watcher died; restarting..." \
      >&2

    start_ad_watcher
  fi

  if ! kill -0 "$CHANNEL_PID" 2>/dev/null; then
    echo -e \
      "\033[0;31m[Prime]\033[0m Channel supervisor died; restarting..." \
      >&2

    start_channel
  fi

  sleep 2
done


# Shutdown

echo "[!] 7-day limit reached. Stopping broadcast."

exit 0
