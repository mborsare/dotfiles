#!/usr/bin/env bash
set -euo pipefail

# --- Configuration ---
PORT="8090"
ROOT_HLS_DIR="/tmp/broadcast-hls"
FFMPEG="ffmpeg"
BUMPERS_DIR="$HOME/Documents/Bumpers"
LOGO_PATH="$HOME/Documents/Prime/logotype.png"
CHANNELS=(
  "looney|Looney Tunes|$HOME/Documents/Looneytunes|1280:720"
)

# Sentinel file replaces SHUTTING_DOWN variable.
# Subshells get a copy of variables at fork-time, so SHUTTING_DOWN=1
# in the parent was invisible to all running loops.
STOP_FILE="/tmp/broadcast-stop-$$"

cleanup() {
  touch "$STOP_FILE"
  echo -e "\n\033[0;31m[!] Atomic Cleanup Initiated...\033[0m"
  lsof -ti :$PORT | xargs kill -9 2>/dev/null || true
  kill $(jobs -p) 2>/dev/null || true
  pkill -9 -f "$ROOT_HLS_DIR" 2>/dev/null || true
  rm -f "$STOP_FILE"
  echo "[+] Broadcast stopped."
  exit 0
}
trap cleanup EXIT INT TERM

start_server() {
  echo "[*] Starting Web Server on port $PORT..."
  python3 -m http.server "$PORT" --directory "$ROOT_HLS_DIR" >/tmp/broadcast-server.log 2>&1 &
}

# Fetches 5 random headlines from NYT RSS via rss2json and joins them
# into a single ticker string. Returns empty string on any failure so
# play_file can fall back gracefully — never blocks the stream.
fetch_headline() {
  local feed="https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml"
  local encoded
  encoded=$(python3 -c 'import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))' "$feed")
  curl -sf --max-time 5 "https://api.rss2json.com/v1/api.json?rss_url=$encoded" \
    | python3 -c "
import json, sys, random
try:
    data = json.load(sys.stdin)
    items = data.get('items', [])[:10]
    if items:
        picks = [i['title'] for i in random.sample(items, min(5, len(items)))]
        print('   *   '.join(picks))
except:
    pass
" 2>/dev/null || true
}

play_file() {
  local file="$1" width="$2" height="$3" hls_dir="$4" label="$5"
  [[ -f "$STOP_FILE" ]] && return
  echo -e "\033[0;34m[$label]\033[0m Now playing: \033[1m${file##*/}\033[0m"

  # Fetch headline and sanitize for FFmpeg drawtext.
  # drawtext breaks on: colons, single-quotes, backslashes, percent signs,
  # square brackets — strip/replace them all before embedding in the filter.
  local headline
  headline=$(fetch_headline | tr ":'\\%[]=" "       ")
  if [[ -z "$headline" ]]; then
    headline="PRIME BROADCAST"
  fi
  echo -e "\033[0;33m[chyron]\033[0m $headline"

  # Filter chain:
  #   1. setsar=1         — normalize non-square pixels (old broadcast/DVD)
  #                         so scale works on display dimensions
  #   2. scale+pad        — fit to target res with black bars, no distortion
  #   3. force_divisible_by=2 — libx264 requires even pixel dimensions
  #   4. setsar=1 again   — pad can reintroduce non-1 SAR in container metadata
  #   5. logo overlay     — top-right corner watermark
  #   6. drawtext         — scrolling chyron ticker at the bottom
  #      x=W-mod(t*120,W+tw) scrolls right-to-left at 120px/sec, looping
  local FONT_PATH="/System/Library/Fonts/Supplemental/Comic Sans MS.ttf"

  local v_filter
  v_filter="setsar=1,"
  v_filter+="scale=$width:$height:force_original_aspect_ratio=decrease:force_divisible_by=2,"
  v_filter+="pad=$width:$height:(ow-iw)/2:(oh-ih)/2,"
  v_filter+="setsar=1,format=yuv420p [main];"
  v_filter+="movie='$LOGO_PATH',scale=100:-1 [logo];"
  v_filter+="[main][logo] overlay=W-w-20:20 [combined];"
  v_filter+="[combined] drawtext="
  v_filter+="fontfile='$FONT_PATH':"
  v_filter+="text='$headline':"
 v_filter+="x=W-mod(t*60\\,W+tw):"
  v_filter+="y=H-30:"
  v_filter+="fontsize=18:"
  v_filter+="fontcolor=white:"
  v_filter+="box=1:"
  v_filter+="boxcolor=red@0.65:"
  v_filter+="boxborderw=6:"
  v_filter+="shadowcolor=black@0.85:"
  v_filter+="shadowx=1:"
  v_filter+="shadowy=1"

  # Prefix segment filenames with a timestamp so each FFmpeg invocation
  # writes unique names. Without this every new process resets to
  # seg_00000.ts and can stomp segments a slow player is still fetching.
  local seg_prefix
  seg_prefix="$(date +%s)"

  "$FFMPEG" -nostdin -hide_banner -loglevel error -re -i "$file" \
    -vf "$v_filter" \
    -c:v libx264 -preset ultrafast -tune zerolatency -crf 23 -g 60 \
    -c:a aac -b:a 128k -ar 44100 \
    -f hls \
    -hls_time 4 \
    -hls_list_size 10 \
    -hls_flags delete_segments+discont_start \
    -hls_segment_filename "$hls_dir/seg_${seg_prefix}_%05d.ts" \
    "$hls_dir/index.m3u8" || true
}

start_channel() {
  local name="$1" display_name="$2" media_dir="$3" size="$4"
  local width="${size%%:*}" height="${size##*:}"
  local hls_dir="$ROOT_HLS_DIR/$name"
  local playlist_txt="$hls_dir/files.txt"
  local bumper_txt="$hls_dir/bumpers.txt"

  mkdir -p "$hls_dir"
  find "$media_dir" -type f \( -iname "*.mp4" -o -iname "*.mkv" -o -iname "*.mov" \) | sort > "$playlist_txt"
  [[ -d "$BUMPERS_DIR" ]] && find "$BUMPERS_DIR" -type f \( -iname "*.mp4" -o -iname "*.mkv" \) > "$bumper_txt"

  (
    while [[ ! -f "$STOP_FILE" ]]; do
      shuf "$playlist_txt" | while IFS= read -r episode; do
        [[ -f "$STOP_FILE" ]] && break

        # Bumper logic
        if [[ -s "$bumper_txt" ]]; then
          play_file "$(shuf -n 1 "$bumper_txt")" "$width" "$height" "$hls_dir" "$display_name BUMPER"
        fi

        # Episode logic
        play_file "$episode" "$width" "$height" "$hls_dir" "$display_name"
      done
    done
  ) &
}

# --- Execution ---
pkill -9 -f "python3 -m http.server $PORT" 2>/dev/null || true
pkill -9 -f "$ROOT_HLS_DIR" 2>/dev/null || true
rm -rf "$ROOT_HLS_DIR" && mkdir -p "$ROOT_HLS_DIR"
rm -f "$STOP_FILE"

start_server

for channel in "${CHANNELS[@]}"; do
  IFS='|' read -r name display_name media_dir size <<< "$channel"
  start_channel "$name" "$display_name" "$media_dir" "$size"
done

echo "[*] Initializing streams..."
for channel in "${CHANNELS[@]}"; do
  IFS='|' read -r name _ _ _ <<< "$channel"
  until [[ -f "$ROOT_HLS_DIR/$name/index.m3u8" ]]; do sleep 0.5; done
done

echo -e "\n\033[1;32m------------------------------------------------\033[0m"
echo -e "\033[1;32m   PRIME BROADCAST LIVE \033[0m"
echo -e "\033[1;32m------------------------------------------------\033[0m"
for channel in "${CHANNELS[@]}"; do
  IFS='|' read -r name display_name _ _ <<< "$channel"
  echo -e "\033[1mChannel:\033[0m $display_name"
  echo "http://localhost:$PORT/$name/index.m3u8"
  echo ""
done
echo "Press Ctrl+C to stop."
wait
