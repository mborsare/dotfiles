#!/usr/bin/env bash
set -euo pipefail

# Configuration Defaults

PORT="${PORT:-8080}"
BIND_ADDR="${BIND_ADDR:-0.0.0.0}"
ROOT_HLS_DIR="${ROOT_HLS_DIR:-/tmp/vhs_hls}"
MEDIA_PATH="${MEDIA_PATH:-./media}"
ADS_DIR="${ADS_DIR:-./ads}"
QUOTES_FILE="${QUOTES_FILE:-./quotes.txt}"
RESTART_DELAY_SECONDS="${RESTART_DELAY_SECONDS:-2}"
DEFAULT_SCROLL_TEXT="${DEFAULT_SCROLL_TEXT:-LATE NIGHT BROADCAST /// RETRO CRT SIMULATION /// DIRECT-TO-TAPE STREAMING}"

# State Files & Runtime Directories

CONTROL_DIR="${ROOT_HLS_DIR}/control"
STOP_FILE="${CONTROL_DIR}/stop"
SCROLL_TEXT_FILE="${CONTROL_DIR}/scroll_text.txt"
NOW_PLAYING_FILE="${CONTROL_DIR}/now_playing.txt"
AD_NOW_FILE="${CONTROL_DIR}/play_ad_now"
BROADCAST_PID_FILE="${CONTROL_DIR}/broadcast.pid"

SERVER_PID=""
QUOTE_PID=""
AD_WATCHER_PID=""
CHANNEL_PID=""

# Helper Functions

log_info() {
  echo -e "\033[0;32m[INFO]\033[0m $*"
}

log_warn() {
  echo -e "\033[0;33m[WARN]\033[0m $*"
}

log_err() {
  echo -e "\033[0;31m[ERROR]\033[0m $*"
}

require_runtime() {
  local cmds=("ffmpeg" "ffprobe" "python3")
  for cmd in "${cmds[@]}"; do
    if ! command -v "$cmd" &>/dev/null; then
      log_err "Required command missing: $cmd"
      exit 1
    fi
  done
}

cleanup() {
  local exit_code=$?
  trap - EXIT INT TERM

  log_info "Cleaning up processes and temporary files..."

  touch "$STOP_FILE" 2>/dev/null || true

  for pid in "$CHANNEL_PID" "$AD_WATCHER_PID" "$QUOTE_PID" "$SERVER_PID"; do
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
  done

  rm -rf "$ROOT_HLS_DIR" 2>/dev/null || true
  exit "$exit_code"
}

set_scroll_text() {
  local text="$1"
  mkdir -p "$CONTROL_DIR"
  printf "%s\n" "$text" > "$SCROLL_TEXT_FILE"
}

list_media_files() {
  local path="$1"
  if [[ -f "$path" ]]; then
    printf "%s\0" "$path"
  elif [[ -d "$path" ]]; then
    find -L "$path" -type f \( -iname "*.mp4" -o -iname "*.mkv" -o -iname "*.mov" -o -iname "*.avi" -o -iname "*.webm" \) -print0 | sort -z
  fi
}

# HLS Transcoding & Rewind Mechanics

run_ffmpeg_hls() {
  local input_file="$1"
  local hls_dir="$2"
  local video_filter="$3"
  local loop_mode="$4"

  mkdir -p "$hls_dir"

  local filter_arg=""
  if [[ -n "$video_filter" ]]; then
    filter_arg="-vf $video_filter"
  fi

  ffmpeg -hide_banner -loglevel error -re \
    -i "$input_file" \
    $filter_arg \
    -c:v libx264 -preset ultrafast -tune zerolatency \
    -c:a aac -ar 44100 -ac 2 \
    -f hls \
    -hls_time 2 \
    -hls_list_size 5 \
    -hls_flags delete_segments+omit_endlist \
    -hls_segment_filename "${hls_dir}/segment_%03d.ts" \
    "${hls_dir}/stream.m3u8"
}

run_rewind_hls() {
  local media_file="$1"
  local hls_dir="$2"
  local width="$3"
  local height="$4"

  log_info "Simulating VHS rewind slate for: $media_file"
  set_scroll_text "REWINDING TAPE /// PLEASE STAND BY"

  # Fast visual scramble filter representing rewind artifacts
  local rewind_filter="drawtext=text='<< REW':fontcolor=white:fontsize=48:x=50:y=50,noise=alls=20:allf=t+u,eq=saturation=0.2"

  ffmpeg -hide_banner -loglevel error -re \
    -f lavfi -i "color=c=blue:s=${width}x${height}:d=3" \
    -vf "$rewind_filter" \
    -c:v libx264 -preset ultrafast \
    -c:a aac -ar 44100 -ac 2 \
    -f hls \
    -hls_time 2 \
    -hls_list_size 5 \
    -hls_flags delete_segments+omit_endlist \
    -hls_segment_filename "${hls_dir}/segment_%03d.ts" \
    "${hls_dir}/stream.m3u8" || true

  set_scroll_text "$DEFAULT_SCROLL_TEXT"
}

# Manifest & Server Workers

write_channel_manifest() {
  mkdir -p "$ROOT_HLS_DIR"
  cat <<EOF > "${ROOT_HLS_DIR}/index.html"
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>VHS Retro Stream</title>
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
  <style>
    body { background: #050505; color: #33ff33; font-family: monospace; text-align: center; margin: 0; padding: 20px; }
    #player { width: 800px; height: 450px; background: #000; margin: 0 auto; border: 4px solid #333; box-shadow: 0 0 20px #00ff6633; }
    #ticker { width: 800px; margin: 10px auto; background: #111; overflow: hidden; white-space: nowrap; border: 1px solid #333; }
    #ticker span { display: inline-block; padding-left: 100%; animation: ticker 15s linear infinite; }
    @keyframes ticker { 0% { transform: translate(0, 0); } 100% { transform: translate(-100%, 0); } }
  </style>
</head>
<body>
  <h1>LIVE BROADCAST CHANNEL</h1>
  <video id="player" controls autoplay muted></video>
  <div id="ticker"><span id="ticker-text">LOADING...</span></div>
  <script>
    const video = document.getElementById('player');
    if (Hls.isSupported()) {
      const hls = new Hls();
      hls.loadSource('/live/stream.m3u8');
      hls.attachMedia(video);
    } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
      video.src = '/live/stream.m3u8';
    }
    
    async function updateTicker() {
      try {
        const res = await fetch('/control/scroll_text.txt');
        if (res.ok) { document.getElementById('ticker-text').innerText = await res.text(); }
      } catch (e) {}
    }
    setInterval(updateTicker, 3000);
    updateTicker();
  </script>
</body>
</html>
EOF
}

start_server() {
  log_info "Starting HTTP File Server on $BIND_ADDR:$PORT"
  python3 -m http.server "$PORT" --bind "$BIND_ADDR" --directory "$ROOT_HLS_DIR" &>/dev/null &
  SERVER_PID="$!"
}

wait_for_server() {
  local retries=30
  while (( retries > 0 )); do
    if nc -z "$BIND_ADDR" "$PORT" 2>/dev/null || python3 -c "import socket; s = socket.socket(); s.connect(('$BIND_ADDR', $PORT))" 2>/dev/null; then
      log_info "HTTP Server ready."
      return 0
    fi
    sleep 0.2
    (( retries-- ))
  done
  log_err "Server failed to start."
  exit 1
}

# Background Feature Watchers

start_quote_file() {
  if [[ ! -f "$QUOTES_FILE" ]]; then
    return 0
  fi

  (
    while [[ ! -f "$STOP_FILE" ]]; do
      shuf -n 1 "$QUOTES_FILE" | while read -r line; do
        if [[ -n "$line" && ! -f "$AD_NOW_FILE" ]]; then
          set_scroll_text "$line"
        fi
      done
      sleep 30
    done
  ) &
  QUOTE_PID="$!"
}

start_ad_watcher() {
  if [[ ! -d "$ADS_DIR" ]]; then
    return 0
  fi

  (
    while [[ ! -f "$STOP_FILE" ]]; do
      if [[ -f "$AD_NOW_FILE" ]]; then
        sleep 2
        continue
      fi

      # Every 5 minutes pick a random ad if available
      sleep 300
      local ad_file
      ad_file="$(find "$ADS_DIR" -type f \( -iname "*.mp4" -o -iname "*.mkv" \) 2>/dev/null | shuf -n 1 || true)"
      if [[ -n "$ad_file" ]]; then
        printf "%s\n" "$ad_file" > "$AD_NOW_FILE"
      fi
    done
  ) &
  AD_WATCHER_PID="$!"
}

# Core Channel Supervisor Loop

start_channel() {
  local hls_dir="${ROOT_HLS_DIR}/live"
  local width=1280
  local height=720
  local v_filter="scale=${width}:${height}:force_original_aspect_ratio=decrease,pad=${width}:${height}:(ow-iw)/2:(oh-ih)/2"

  mkdir -p "$hls_dir" "$CONTROL_DIR"

  (
    while [[ ! -f "$STOP_FILE" ]]; do

      # 1. Commercial Interrupt Handler
      if [[ -s "$AD_NOW_FILE" ]]; then
        local ad_path
        ad_path="$(cat "$AD_NOW_FILE" 2>/dev/null || true)"

        if [[ -n "$ad_path" && -f "$ad_path" ]]; then
          set_scroll_text "COMMERCIAL BREAK"

          echo -e "\033[0;35m[ad]\033[0m Playing commercial: $ad_path"

          run_ffmpeg_hls "$ad_path" "$hls_dir" "$v_filter" "once" || true

          rm -f "$AD_NOW_FILE"
          set_scroll_text "$DEFAULT_SCROLL_TEXT"
          continue
        fi
        rm -f "$AD_NOW_FILE"
      fi

      # 2. Main Content Loop
      while IFS= read -r -d '' media_file; do
        [[ -f "$STOP_FILE" ]] && break

        # Check if an ad was injected while reading media files
        if [[ -s "$AD_NOW_FILE" ]]; then
          break
        fi

        title="$(basename "$media_file" | sed 's/\.[^.]*$//')"
        printf "%s\n" "$title" > "$NOW_PLAYING_FILE"

        echo -e "\033[0;32m[Prime]\033[0m Now Playing: $media_file"

        # If it's a single file, play video + rewind slate; if directory, stream through queue
        if [[ -f "$MEDIA_PATH" ]]; then
          run_ffmpeg_hls "$media_file" "$hls_dir" "$v_filter" "once" || true

          if [[ ! -f "$STOP_FILE" && ! -s "$AD_NOW_FILE" ]]; then
            run_rewind_hls "$media_file" "$hls_dir" "$width" "$height" || true
          fi
        else
          run_ffmpeg_hls "$media_file" "$hls_dir" "$v_filter" "once" || true
        fi

      done < <(list_media_files "$MEDIA_PATH")

      sleep "$RESTART_DELAY_SECONDS"
    done
  ) &

  CHANNEL_PID="$!"
}

# Main Entrypoint

main() {
  trap 'cleanup $?' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  require_runtime

  mkdir -p "$ROOT_HLS_DIR"
  printf '%s\n' "$$" > "$BROADCAST_PID_FILE"

  set_scroll_text "$DEFAULT_SCROLL_TEXT"
  write_channel_manifest

  start_server
  wait_for_server

  start_quote_file
  start_ad_watcher
  start_channel

  echo -e "\033[0;32m[+] Broadcast live at http://$BIND_ADDR:$PORT/index.html\033[0m"

  # Keep main process alive
  while [[ ! -f "$STOP_FILE" ]]; do
    sleep 1
  done
}

main "$@"
