#!/usr/bin/env bash
set -euo pipefail

# --- Configuration ---
PORT="${PORT:-8090}"
BIND_ADDR="${BIND_ADDR:-127.0.0.1}"
ROOT_HLS_DIR="${ROOT_HLS_DIR:-/tmp/broadcast-hls}"
FFMPEG="${FFMPEG:-ffmpeg}"
FFPROBE="${FFPROBE:-ffprobe}"
LOGO_PATH="${LOGO_PATH:-$HOME/Documents/Prime/logotype.png}"

OUTPUT_FPS="${OUTPUT_FPS:-24}"
VIDEO_BITRATE="${VIDEO_BITRATE:-1000k}"
VIDEO_MAXRATE="${VIDEO_MAXRATE:-1300k}"
VIDEO_BUFSIZE="${VIDEO_BUFSIZE:-2600k}"
AUDIO_BITRATE="${AUDIO_BITRATE:-96k}"

HLS_TIME="${HLS_TIME:-2}"
HLS_LIST_SIZE="${HLS_LIST_SIZE:-6}"
HLS_DELETE_THRESHOLD="${HLS_DELETE_THRESHOLD:-3}"

DEFAULT_MEDIA_DIR="${DEFAULT_MEDIA_DIR:-$HOME/Documents/Will-broadcast/}"
DEFAULT_SIZE="${DEFAULT_SIZE:-640:360}"

QUOTE_BASE_URL="${QUOTE_BASE_URL:-https://weather.mborsare.workers.dev/prime/weather}"
QUOTE_REFRESH_SECONDS="${QUOTE_REFRESH_SECONDS:-15}"

# Empty means no crawl/ticker.
DEFAULT_SCROLL_TEXT="${DEFAULT_SCROLL_TEXT:-}"
SCROLL_SPEED="${SCROLL_SPEED:-95}"

# Bottom bug layout.
BUG_PAD="${BUG_PAD:-24}"
BUG_LOGO_WIDTH="${BUG_LOGO_WIDTH:-055}"
BUG_ROW_BOTTOM="${BUG_ROW_BOTTOM:-58}"
BUG_FONT_SIZE="${BUG_FONT_SIZE:-22}"
BUG_BOX_PAD="${BUG_BOX_PAD:-8}"
TICKER_BOTTOM="${TICKER_BOTTOM:-22}"
TICKER_FONT_SIZE="${TICKER_FONT_SIZE:-24}"
TICKER_BOX_PAD="${TICKER_BOX_PAD:-8}"

AD_REQUEST_FILE="${AD_REQUEST_FILE:-/tmp/broadcast-ad-request.txt}"
AD_NOW_FILE="${AD_NOW_FILE:-/tmp/broadcast-ad-now.txt}"

SERVER_PID=""
QUOTE_PID=""
AD_PID=""
CHANNEL_PID=""
TIMER_PID=""
ENCODER_PID_FILE="$ROOT_HLS_DIR/encoder.pid"
BROADCAST_PID_FILE="$ROOT_HLS_DIR/broadcast.pid"
SLEEP_FILE="${SLEEP_FILE:-/tmp/broadcast-sleep.txt}"

QUOTE_FILE="/tmp/broadcast-quotes-$$.txt"
SCROLL_FILE="/tmp/broadcast-scroll-$$.txt"
STOP_FILE="/tmp/broadcast-stop-$$"

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat <<'EOF'
usage: broadcast [MEDIA_FILE_OR_DIR]
       broadcast ad SECONDS FILE
       broadcast sleep MINUTES

With no media argument, plays ~/Documents/Will-broadcast.
Defaults: 640x360, 24 fps, 2-second HLS segments.
Set DEFAULT_MEDIA_DIR, DEFAULT_SIZE, OUTPUT_FPS, HLS_TIME, PORT,
or BIND_ADDR in the environment to override these settings.
EOF
  exit 0
fi

# --- Sleep timer command ---
if [[ "${1:-}" == "sleep" ]]; then
  if [[ $# -ne 2 || ! "$2" =~ ^[0-9]+$ ]]; then
    echo "usage: broadcast sleep MINUTES" >&2
    exit 2
  fi

  if [[ ! -s "$BROADCAST_PID_FILE" ]]; then
    echo "No running broadcast found in $ROOT_HLS_DIR" >&2
    exit 1
  fi

  read -r broadcast_pid < "$BROADCAST_PID_FILE"
  if ! [[ "$broadcast_pid" =~ ^[0-9]+$ ]]; then
    echo "Invalid broadcast PID file: $BROADCAST_PID_FILE" >&2
    exit 1
  fi

  broadcast_is_running() {
    local command_line
    command_line="$(ps -p "$broadcast_pid" -o args= 2>/dev/null || true)"
    [[ "$command_line" =~ (^|[[:space:]/])broadcast([[:space:]]|$) ]]
  }

  if ! broadcast_is_running; then
    echo "Broadcast PID $broadcast_pid is no longer running" >&2
    exit 1
  fi

  format_remaining() {
    local total="$1"
    local days=$((total / 86400))
    local hours=$(((total % 86400) / 3600))
    local minutes=$(((total % 3600) / 60))
    local seconds=$((total % 60))
    if (( days > 0 )); then
      printf '%dd %02dh %02dm %02ds' "$days" "$hours" "$minutes" "$seconds"
    elif (( hours > 0 )); then
      printf '%dh %02dm %02ds' "$hours" "$minutes" "$seconds"
    elif (( minutes > 0 )); then
      printf '%dm %02ds' "$minutes" "$seconds"
    else
      printf '%ds' "$seconds"
    fi
  }

  trap 'rm -f "$SLEEP_FILE"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  end_epoch=$(( $(date +%s) + 10#$2 * 60 ))
  last_text=""
  while (( $(date +%s) < end_epoch )); do
    if ! broadcast_is_running; then
      echo "Broadcast stopped before the sleep timer ended" >&2
      exit 1
    fi
    remaining=$((end_epoch - $(date +%s)))
    if (( remaining <= 60 )); then
      current_text="sleep $(format_remaining "$remaining")"
    else
      current_text="sleep $(((remaining + 59) / 60))m"
    fi
    if [[ "$current_text" != "$last_text" ]]; then
      printf '%s\n' "$current_text" > "$SLEEP_FILE"
      last_text="$current_text"
    fi
    sleep 1
  done

  if broadcast_is_running; then
    kill "$broadcast_pid"
  fi
  exit 0
fi

# --- Ad trigger mode ---
run_ad_command=0

if [[ "$(basename "$0")" == "broadcastad" ]]; then
  run_ad_command=1
fi

if [[ "${1:-}" == "ad" ]]; then
  run_ad_command=1
  shift
fi

if [[ "$run_ad_command" -eq 1 ]]; then
  if [[ $# -lt 2 ]]; then
    echo "usage: broadcast ad SECONDS FILE" >&2
    echo "   or: broadcastad SECONDS FILE" >&2
    exit 1
  fi

  delay="$1"
  ad_file="$2"

  if ! [[ "$delay" =~ ^[0-9]+$ ]]; then
    echo "Delay must be seconds, like: 45" >&2
    exit 1
  fi

  ad_path="$(
    python3 - "$ad_file" <<'PY'
import sys
from pathlib import Path

p = Path(sys.argv[1]).expanduser()

try:
    print(str(p.resolve(strict=True)))
except FileNotFoundError:
    raise SystemExit(2)
PY
  )" || {
    echo "No such ad file: $ad_file" >&2
    exit 1
  }

  tmp="${AD_REQUEST_FILE}.$$"
  printf "%s\t%s\n" "$delay" "$ad_path" > "$tmp"
  mv "$tmp" "$AD_REQUEST_FILE"

  echo "Ad queued: break in ${delay}s -> $ad_path"
  exit 0
fi

if [[ $# -gt 1 ]]; then
  echo "usage: broadcast [MEDIA_FILE_OR_DIR]" >&2
  exit 2
fi

MEDIA_PATH="${1:-$DEFAULT_MEDIA_DIR}"
if [[ ! -e "$MEDIA_PATH" ]]; then
  echo "No such file or folder: $MEDIA_PATH" >&2
  exit 1
fi

set_scroll_text() {
  local text="${1:-}"

  if [[ -n "$text" ]]; then
    printf "%s\n" "$text" > "$SCROLL_FILE"
  else
    : > "$SCROLL_FILE"
  fi
}

set_break_countdown_text() {
  local remaining="$1"

  if [[ -n "$DEFAULT_SCROLL_TEXT" ]]; then
    set_scroll_text "COMMERCIAL BREAK IN ${remaining}  //  ${DEFAULT_SCROLL_TEXT}"
  else
    set_scroll_text "COMMERCIAL BREAK IN ${remaining}"
  fi
}

kill_encoder() {
  local pid=""
  if [[ -s "$ENCODER_PID_FILE" ]]; then
    read -r pid < "$ENCODER_PID_FILE" || true
    if [[ "$pid" =~ ^[0-9]+$ ]]; then
      kill "$pid" 2>/dev/null || true
      local attempt
      for attempt in {1..50}; do
        [[ ! -e "$ENCODER_PID_FILE" ]] && return 0
        sleep 0.1
      done
      kill -9 "$pid" 2>/dev/null || true
    fi
  fi
}

require_runtime() {
  local missing=()
  local cmd

  for cmd in "$FFMPEG" "$FFPROBE" python3 curl; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      missing+=("$cmd")
    fi
  done

  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Missing required app(s): ${missing[*]}" >&2
    exit 1
  fi

  if [[ ! -f "$LOGO_PATH" ]]; then
    echo "[warn] Logo not found, continuing without logo: $LOGO_PATH" >&2
  fi
}

cleanup() {
  local status="$1"
  touch "$STOP_FILE"
  echo -e "\n\033[0;31m[!] Cleanup...\033[0m"

  kill_encoder
  local pid
  for pid in "$CHANNEL_PID" "$AD_PID" "$QUOTE_PID" "$SERVER_PID" "$TIMER_PID"; do
    if [[ -n "$pid" ]]; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
    fi
  done
  rm -rf "$ROOT_HLS_DIR"

  rm -f "$STOP_FILE" "$QUOTE_FILE" "$SCROLL_FILE"
  rm -f "$AD_NOW_FILE"

  echo "[+] Broadcast stopped."
  return "$status"
}
start_server() {
  echo "[*] Starting Web Server on $BIND_ADDR:$PORT..."
  BIND_ADDR="$BIND_ADDR" PORT="$PORT" ROOT_HLS_DIR="$ROOT_HLS_DIR" python3 - >/tmp/broadcast-server.log 2>&1 <<'PY' &
import http.server
import os

BIND_ADDR = os.environ["BIND_ADDR"]
PORT = int(os.environ["PORT"])
ROOT = os.environ["ROOT_HLS_DIR"]

class HLSHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=ROOT, **kwargs)

    def guess_type(self, path):
        path = str(path)
        if path.endswith(".m3u8"):
            return "application/vnd.apple.mpegurl"
        if path.endswith(".ts"):
            return "video/mp2t"
        if path.endswith(".json"):
            return "application/json"
        return super().guess_type(path)

    def end_headers(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "no-cache")
        super().end_headers()

    def log_message(self, fmt, *args):
        pass

http.server.HTTPServer((BIND_ADDR, PORT), HLSHandler).serve_forever()
PY
  SERVER_PID="$!"
}

wait_for_server() {
  local check_addr="$BIND_ADDR"
  if [[ "$check_addr" == "0.0.0.0" || "$check_addr" == "::" ]]; then
    check_addr="127.0.0.1"
  fi
  local url="http://$check_addr:$PORT/channels.json"
  local i

  for i in {1..50}; do
    if curl -sf --max-time 1 "$url" >/dev/null 2>&1; then
      return 0
    fi

    if [[ -n "$SERVER_PID" ]] && ! kill -0 "$SERVER_PID" 2>/dev/null; then
      echo "[error] Web server exited before it was reachable." >&2
      cat /tmp/broadcast-server.log >&2 2>/dev/null || true
      exit 1
    fi

    sleep 0.1
  done

  echo "[error] Web server did not become reachable at $url" >&2
  cat /tmp/broadcast-server.log >&2 2>/dev/null || true
  exit 1
}

fetch_quote() {
  local symbol="$1"
  local url="$QUOTE_BASE_URL/$symbol"
  local out=""

  out="$(curl -sf --max-time 5 "$url" 2>/dev/null | python3 -c '
import json
import math
import sys

try:
    d = json.load(sys.stdin)
    price = None

    if isinstance(d, dict):
        for key in ("price", "last", "mark", "close", "c"):
            if d.get(key) is not None:
                price = d[key]
                break

        series = d.get("priceSeries") or d.get("prices") or d.get("data") or []
        if price is None and isinstance(series, list) and series:
            latest = series[-1]
            if isinstance(latest, dict):
                for key in ("last", "price", "mark", "close", "c"):
                    if latest.get(key) is not None:
                        price = latest[key]
                        break
                if price is None and latest.get("hi") is not None and latest.get("lo") is not None:
                    price = (float(latest["hi"]) + float(latest["lo"])) / 2
            else:
                price = latest

    if price is None:
        raise ValueError("missing price")

    value = float(price)
    if not math.isfinite(value):
        raise ValueError("bad price")

    if abs(value - round(value)) < 0.001:
        print(str(int(round(value))))
    else:
        print((f"{value:.2f}").rstrip("0").rstrip("."))
except Exception:
    print("-----")
' 2>/dev/null || true)"

  if [[ -z "$out" ]]; then
    out="-----"
  fi

  printf "%s" "$out"
}

start_quote_file() {
  (
    local nq_now="-----"
    local next_quote_refresh=0
    local now_epoch=""
    local current_time=""

    while [[ ! -f "$STOP_FILE" ]]; do
      now_epoch="$(date +%s)"
      current_time="$(date '+%H:%M:%S')"

      if [[ "$now_epoch" -ge "$next_quote_refresh" ]]; then
        nq_now="$(fetch_quote NQ)"
        next_quote_refresh=$((now_epoch + QUOTE_REFRESH_SECONDS))
      fi

      printf "%s  NQ %s\n" "$current_time" "$nq_now" > "$QUOTE_FILE"

      sleep 1
    done
  ) &
  QUOTE_PID="$!"
}

start_ad_watcher() {
  (
    while [[ ! -f "$STOP_FILE" ]]; do
      if [[ -f "$AD_NOW_FILE" ]]; then
        sleep 1
        continue
      fi

      if [[ ! -s "$AD_REQUEST_FILE" ]]; then
        sleep 1
        continue
      fi

      local delay=""
      local ad_path=""

      IFS=$'\t' read -r delay ad_path < "$AD_REQUEST_FILE" || true
      rm -f "$AD_REQUEST_FILE"

      if ! [[ "$delay" =~ ^[0-9]+$ ]]; then
        delay="0"
      fi

      if [[ -z "$ad_path" || ! -f "$ad_path" ]]; then
        set_scroll_text "$DEFAULT_SCROLL_TEXT"
        continue
      fi

      local remaining="$delay"

      while [[ "$remaining" -gt 0 && ! -f "$STOP_FILE" ]]; do
        set_break_countdown_text "$remaining"
        sleep 1
        remaining=$((remaining - 1))
      done

      if [[ -f "$STOP_FILE" ]]; then
        break
      fi

      printf "%s\n" "$ad_path" > "$AD_NOW_FILE"
      set_scroll_text "COMMERCIAL BREAK"

      echo -e "\033[0;35m[ad]\033[0m Starting commercial: $ad_path"

      kill_encoder
      sleep 1
    done
  ) &
  AD_PID="$!"
}

write_channel_manifest() {
  local manifest="$ROOT_HLS_DIR/channels.json"

  python3 - "$manifest" <<'PY'
import json
import sys

manifest = sys.argv[1]
out = [{"number": "03", "name": "PRIME", "path": "/Prime/index.m3u8"}]

with open(manifest, "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2)
    f.write("\n")
PY
}

write_concat_playlist() {
  local media_path="$1"
  local playlist_ffconcat="$2"

  python3 - "$media_path" "$playlist_ffconcat" "$FFPROBE" <<'PY'
import random
import json
import subprocess
import sys
from pathlib import Path

media_path = Path(sys.argv[1]).expanduser()
playlist = Path(sys.argv[2])
ffprobe = sys.argv[3]
exts = {".mp4", ".mkv", ".mov", ".m4v", ".webm"}

def stream_signature(path):
    try:
        r = subprocess.run(
            [
                ffprobe,
                "-v", "error",
                "-show_entries", "stream=codec_type,codec_name,time_base,width,height,pix_fmt,sample_rate,channels",
                "-of", "json",
                str(path),
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=8,
        )
        if r.returncode != 0:
            return None
        streams = json.loads(r.stdout).get("streams", [])
        video = next((s for s in streams if s.get("codec_type") == "video"), None)
        audio = next((s for s in streams if s.get("codec_type") == "audio"), None)
        if video is None:
            return None
        video_keys = ("codec_name", "time_base", "width", "height", "pix_fmt")
        audio_keys = ("codec_name", "time_base", "sample_rate", "channels")
        return (
            tuple(video.get(k) for k in video_keys),
            tuple(audio.get(k) for k in audio_keys) if audio else None,
        )
    except Exception:
        return None

if media_path.is_file():
    candidates = [media_path.resolve()]
elif media_path.is_dir():
    candidates = sorted((
        p.resolve()
        for p in media_path.rglob("*")
        if p.is_file() and p.suffix.lower() in exts
    ), key=lambda p: str(p).lower())
else:
    raise SystemExit(f"No such file or folder: {media_path}")

bad = []
groups = {}

for path in candidates:
    signature = stream_signature(path)
    if signature is None:
        bad.append(path)
    else:
        groups.setdefault(signature, []).append(path)

if not groups:
    for path in bad:
        print(f"[skip bad media] {path}", file=sys.stderr)
    raise SystemExit(f"No playable media files found in {media_path}")

# Keep the largest matching set so one unusual file cannot exclude the rest.
good = max(groups.values(), key=len)
incompatible = [
    path for group in groups.values() if group is not good for path in group
]

good.sort(key=lambda p: str(p).lower())
random.shuffle(good)

for path in bad:
    print(f"[skip bad media] {path}", file=sys.stderr)

for path in incompatible:
    print(f"[skip incompatible media] {path}", file=sys.stderr)

print(f"[playlist] {len(good)} playable file(s), {len(bad) + len(incompatible)} skipped", file=sys.stderr)

def ffconcat_quote(path: Path) -> str:
    s = str(path)
    return "'" + s.replace("'", "'\\''") + "'"

with playlist.open("w", encoding="utf-8") as f:
    f.write("ffconcat version 1.0\n")
    for path in good:
        f.write(f"file {ffconcat_quote(path)}\n")
PY
}

write_single_file_playlist() {
  local media_file="$1"
  local playlist_ffconcat="$2"

  python3 - "$media_file" "$playlist_ffconcat" <<'PY'
import sys
from pathlib import Path

media_file = Path(sys.argv[1]).expanduser().resolve()
playlist = Path(sys.argv[2])

if not media_file.is_file():
    raise SystemExit(f"No such media file: {media_file}")

def ffconcat_quote(path: Path) -> str:
    s = str(path)
    return "'" + s.replace("'", "'\\''") + "'"

with playlist.open("w", encoding="utf-8") as f:
    f.write("ffconcat version 1.0\n")
    f.write(f"file {ffconcat_quote(media_file)}\n")
PY
}

build_video_filter() {
  local width="$1"
  local height="$2"
  local font_path=""
  local font_arg=""
  local v_filter=""

  if command -v fc-match >/dev/null 2>&1; then
    font_path="$(fc-match -f '%{file}\n' 'ComicShannsMono Nerd Font' 2>/dev/null | head -n 1 || true)"
  fi

  if [[ -z "$font_path" || ! -f "$font_path" ]]; then
    font_path="/usr/share/fonts/OTF/ComicShannsMonoNerdFont-Regular.otf"
  fi

  if [[ -f "$font_path" ]]; then
    font_arg="fontfile='$font_path':"
  fi

  v_filter="fps=$OUTPUT_FPS,"
  v_filter+="setsar=1,"
  v_filter+="scale=$width:$height:force_original_aspect_ratio=decrease:force_divisible_by=2,"
  v_filter+="pad=$width:$height:(ow-iw)/2:(oh-ih)/2,"
  v_filter+="setsar=1,format=yuv420p[main];"

  # Bottom bug row:
  # [Prime logo]                                [TIME  NQ]
  # [Ticker optional]
  if [[ -f "$LOGO_PATH" ]]; then
    v_filter+="movie='$LOGO_PATH',scale=$BUG_LOGO_WIDTH:-1[logo];"
    v_filter+="[main][logo]overlay=$BUG_PAD:H-h-$BUG_ROW_BOTTOM[bugbase];"
  else
    v_filter+="[main]null[bugbase];"
  fi

  # Bottom-right TIME + NQ bug.
  v_filter+="[bugbase]drawtext="
  v_filter+="$font_arg"
  v_filter+="textfile='$QUOTE_FILE':"
  v_filter+="reload=1:"
  v_filter+="x=W-tw-$BUG_PAD:"
  v_filter+="y=H-th-$BUG_ROW_BOTTOM:"
  v_filter+="fontsize=$BUG_FONT_SIZE:"
  v_filter+="fontcolor=white:"
  v_filter+="box=1:"
  v_filter+="boxcolor=black@0.50:"
  v_filter+="boxborderw=$BUG_BOX_PAD[bugged];"

  # Bottom ticker/crawl. Empty SCROLL_FILE means no visible ticker.
  v_filter+="[bugged]drawtext="
  v_filter+="$font_arg"
  v_filter+="textfile='$SCROLL_FILE':"
  v_filter+="reload=1:"
  v_filter+="x=W-mod(t*$SCROLL_SPEED\\,W+tw):"
  v_filter+="y=H-th-$TICKER_BOTTOM:"
  v_filter+="fontsize=$TICKER_FONT_SIZE:"
  v_filter+="fontcolor=white:"
  v_filter+="box=1:"
  v_filter+="boxcolor=black@0.55:"
  v_filter+="boxborderw=$TICKER_BOX_PAD"

  printf "%s" "$v_filter"
}

run_ffmpeg_hls() {
  local playlist_ffconcat="$1"
  local hls_dir="$2"
  local v_filter="$3"
  local loop_mode="$4"

  local loop_args=()

  if [[ "$loop_mode" == "loop" ]]; then
    loop_args=(-stream_loop -1)
  fi

  "$FFMPEG" -nostdin -hide_banner -loglevel warning \
    -re \
    "${loop_args[@]}" \
    -fflags +genpts+discardcorrupt \
    -err_detect ignore_err \
    -f concat \
    -safe 0 \
    -i "$playlist_ffconcat" \
    -map 0:v:0 \
    -map 0:a? \
    -vf "$v_filter" \
    -c:v libx264 \
    -preset veryfast \
    -profile:v main \
    -b:v "$VIDEO_BITRATE" \
    -maxrate "$VIDEO_MAXRATE" \
    -bufsize "$VIDEO_BUFSIZE" \
    -g "$((OUTPUT_FPS * HLS_TIME))" \
    -pix_fmt yuv420p \
    -c:a aac \
    -b:a "$AUDIO_BITRATE" \
    -ar 44100 \
    -ac 2 \
    -dn \
    -sn \
    -f hls \
    -hls_time "$HLS_TIME" \
    -hls_list_size "$HLS_LIST_SIZE" \
    -hls_start_number_source epoch \
    -hls_flags delete_segments+omit_endlist+program_date_time+independent_segments \
    -hls_delete_threshold "$HLS_DELETE_THRESHOLD" \
    -hls_segment_filename "$hls_dir/seg_%d.ts" \
    "$hls_dir/index.m3u8" &

  local encoder_pid="$!"
  local status=0
  printf '%s\n' "$encoder_pid" > "$ENCODER_PID_FILE"
  wait "$encoder_pid" || status="$?"
  rm -f "$ENCODER_PID_FILE"
  return "$status"
}

start_channel() {
  local width="${DEFAULT_SIZE%%:*}"
  local height="${DEFAULT_SIZE##*:}"
  local hls_dir="$ROOT_HLS_DIR/Prime"
  local main_playlist="$hls_dir/files.ffconcat"
  local ad_playlist="$hls_dir/ad.ffconcat"
  local v_filter

  mkdir -p "$hls_dir"

  write_concat_playlist "$MEDIA_PATH" "$main_playlist"
  v_filter="$(build_video_filter "$width" "$height")"

  echo -e "\033[0;34m[Prime]\033[0m Starting channel encoder..."
  echo "source: $MEDIA_PATH"

  (
    while [[ ! -f "$STOP_FILE" ]]; do
      if [[ -s "$AD_NOW_FILE" ]]; then
        local ad_path=""
        ad_path="$(cat "$AD_NOW_FILE" 2>/dev/null || true)"

        if [[ -n "$ad_path" && -f "$ad_path" ]]; then
          set_scroll_text "COMMERCIAL BREAK"
          echo -e "\033[0;35m[Prime]\033[0m Playing ad: $ad_path"

          if write_single_file_playlist "$ad_path" "$ad_playlist"; then
            run_ffmpeg_hls "$ad_playlist" "$hls_dir" "$v_filter" "once" || true
          fi
        fi

        rm -f "$AD_NOW_FILE"
        set_scroll_text "$DEFAULT_SCROLL_TEXT"
        echo -e "\033[0;35m[Prime]\033[0m Returning to programming..."
        continue
      fi

      run_ffmpeg_hls "$main_playlist" "$hls_dir" "$v_filter" "loop" || true

      if [[ ! -f "$STOP_FILE" && ! -f "$AD_NOW_FILE" ]]; then
        echo -e "\033[0;31m[Prime]\033[0m Encoder exited. Restarting in 2 seconds..."
        sleep 2
      fi
    done
  ) &
  CHANNEL_PID="$!"
}

# --- Execution ---
if ! [[ "$OUTPUT_FPS" =~ ^[0-9]+$ ]] || (( OUTPUT_FPS < 24 )); then
  echo "OUTPUT_FPS must be an integer of at least 24" >&2
  exit 2
fi
if ! [[ "$HLS_TIME" =~ ^[0-9]+$ ]] || (( HLS_TIME < 1 )); then
  echo "HLS_TIME must be a positive integer" >&2
  exit 2
fi
require_runtime

python3 - "$BIND_ADDR" "$PORT" <<'PY'
import socket
import sys

address, port = sys.argv[1], int(sys.argv[2])
family = socket.AF_INET6 if ":" in address else socket.AF_INET
try:
    with socket.socket(family, socket.SOCK_STREAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind((address, port))
except OSError as exc:
    raise SystemExit(f"Cannot bind {address}:{port}: {exc}")
PY

if [[ -s "$BROADCAST_PID_FILE" ]]; then
  read -r previous_pid < "$BROADCAST_PID_FILE" || true
  if [[ "$previous_pid" =~ ^[0-9]+$ ]] && kill -0 "$previous_pid" 2>/dev/null; then
    echo "Broadcast is already running (PID $previous_pid)" >&2
    exit 1
  fi
fi

rm -rf "$ROOT_HLS_DIR"
mkdir -p "$ROOT_HLS_DIR"
printf '%s\n' "$$" > "$BROADCAST_PID_FILE"
trap 'cleanup $?' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

rm -f "$STOP_FILE" "$QUOTE_FILE" "$SCROLL_FILE"
rm -f "$AD_NOW_FILE"

printf "%s\n" "$(date '+%H:%M:%S')  NQ -----" > "$QUOTE_FILE"
set_scroll_text "$DEFAULT_SCROLL_TEXT"

write_channel_manifest

start_server
wait_for_server
start_quote_file
start_ad_watcher

start_channel

echo "[*] Initializing streams..."

ready=0
for _ in {1..120}; do
  if [[ -f "$ROOT_HLS_DIR/Prime/index.m3u8" ]]; then
    ready=1
    break
  fi
  sleep 0.5
done
if [[ "$ready" -ne 1 ]]; then
  echo "[error] Prime never produced index.m3u8" >&2
  exit 1
fi

echo -e "\n\033[1;32m------------------------------------------------\033[0m"
echo -e "\033[1;32m    PRIME BROADCAST LIVE \033[0m"
echo -e "\033[1;32m------------------------------------------------\033[0m"

echo -e "\033[1mManifest:\033[0m http://localhost:$PORT/channels.json"
echo ""

echo "Source: $MEDIA_PATH"
echo "http://localhost:$PORT/Prime/index.m3u8"
echo ""

echo "Ad trigger:"
echo "./$(basename "$0") ad 45 /path/to/foo.mp4"
echo "Sleep timer:"
echo "./$(basename "$0") sleep 90"
echo ""
echo "Press Ctrl+C to stop."

sleep 604800 &
TIMER_PID="$!"

while kill -0 "$SERVER_PID" 2>/dev/null &&
      kill -0 "$QUOTE_PID" 2>/dev/null &&
      kill -0 "$AD_PID" 2>/dev/null &&
      kill -0 "$CHANNEL_PID" 2>/dev/null &&
      kill -0 "$TIMER_PID" 2>/dev/null; do
  sleep 1
done

if ! kill -0 "$TIMER_PID" 2>/dev/null; then
  echo "[!] 7-day limit reached. Stopping broadcast."
  exit 0
fi

echo "[error] A broadcast process exited unexpectedly." >&2
exit 1
