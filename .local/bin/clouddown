#!/usr/bin/env bash
set -euo pipefail

MOUNT="$HOME/mnt/cloud"

"$HOME/.local/libexec/cloud-service" stop

is_mounted() {
  if [[ "$(uname -s)" == Darwin ]]; then
    /sbin/mount | awk -v target="$MOUNT" '
      index($0, " on " target " (") { found = 1 }
      END { exit !found }
    '
  else
    mountpoint -q "$MOUNT"
  fi
}

if ! is_mounted; then
  echo "cloud is already unmounted"
  exit 0
fi

if [[ "$(uname -s)" == Darwin ]]; then
  /sbin/umount "$MOUNT"
else
  if command -v fusermount3 >/dev/null 2>&1; then
    fusermount3 -u "$MOUNT"
  else
    fusermount -u "$MOUNT"
  fi
fi
echo "unmounted cloud"
