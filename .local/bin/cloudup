#!/usr/bin/env bash
set -euo pipefail

MOUNT="$HOME/mnt/cloud"

is_mounted() {
  if [[ "$(uname -s)" == Darwin ]]; then
    /sbin/mount | awk -v target="$MOUNT" '
      index($0, " on " target " (") { found = 1 }
      END { exit !found }
    '
  else
    mountpoint -q "$MOUNT"
  fi
}
mkdir -p "$MOUNT"

if ! command -v sshfs >/dev/null 2>&1; then
  if [[ "$(uname -s)" == Darwin ]]; then
    echo "SSHFS is missing. Install SSHFS and macFUSE." >&2
  else
    echo "SSHFS is missing. Install it with: omarchy pkg add sshfs" >&2
  fi
  exit 1
fi

"$HOME/.local/libexec/cloud-service" start

if is_mounted; then
  echo "cloud already mounted at $MOUNT"
  exit 0
fi

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cloud"
mkdir -p "$LOG_DIR"
for ((attempt=0; attempt<60; attempt++)); do
  if is_mounted; then
    echo "mounted cloud at $MOUNT"
    exit 0
  fi
  sleep 0.5
done

echo "cloud mount is pending; the background service will keep retrying" >&2
if [[ "$(uname -s)" == Darwin ]]; then
  echo "See $LOG_DIR/service.log" >&2
else
  echo "See: journalctl --user -u cloudup.service" >&2
fi
exit 1
