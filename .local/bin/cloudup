#!/usr/bin/env bash
set -euo pipefail

MOUNT="$HOME/mnt/cloud"

is_mounted() {
  if [[ "$(uname -s)" == Darwin ]]; then
    /sbin/mount | awk -v target="$MOUNT" '
      index($0, " on " target " (") { found = 1 }
      END { exit !found }
    '
  else
    mountpoint -q "$MOUNT"
  fi
}
REMOTE="mikeb@oldbook:/mnt/PRIME"

mkdir -p "$MOUNT"

if is_mounted; then
  echo "cloud already mounted at $MOUNT"
  exit 0
fi

if ! command -v sshfs >/dev/null 2>&1; then
  if [[ "$(uname -s)" == Darwin ]]; then
    echo "SSHFS is missing. Install SSHFS and macFUSE." >&2
  else
    echo "SSHFS is missing. Install it with: omarchy pkg add sshfs" >&2
  fi
  exit 1
fi

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cloud"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/cloudup.log"
nohup sshfs -f "$REMOTE" "$MOUNT" \
  -o reconnect \
  -o ServerAliveInterval=15 \
  -o ServerAliveCountMax=3 >"$LOG" 2>&1 &
SSHFS_PID=$!

for ((attempt=0; attempt<60; attempt++)); do
  if ! kill -0 "$SSHFS_PID" 2>/dev/null; then
    echo "cloud mount failed; SSHFS output:" >&2
    cat "$LOG" >&2
    exit 1
  fi
  if is_mounted; then
    echo "mounted cloud at $MOUNT"
    exit 0
  fi
  sleep 0.5
done

echo "cloud mount is still pending; see $LOG" >&2
exit 1
