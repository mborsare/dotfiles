#!/usr/bin/env bash
set -euo pipefail

DEST="${XEROX_DEST:-cloud}"
MOVE=0
DRY_RUN=0

usage() {
  cat >&2 <<'EOF'
usage: xerox [-m] [-n] [-t DEST] PATH
  -m, --move       delete source files after transfer
  -n, --dry-run    show what would happen
  -t, --to DEST    cloud | oldbook | primebook | morningbrief (default: cloud)
  -l, --list       list destinations
  -h, --help       show this help
EOF
}

die() {
  printf 'xerox: %s\n' "$*" >&2
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -l|--list) printf '%s\n' cloud oldbook primebook morningbrief; exit 0 ;;
    -m|--move) MOVE=1; shift ;;
    -n|--dry-run) DRY_RUN=1; shift ;;
    -t|--to) [[ $# -ge 2 ]] || die "--to needs a destination"; DEST="$2"; shift 2 ;;
    --to=*) DEST="${1#--to=}"; shift ;;
    -*) die "unknown option: $1" ;;
    *) break ;;
  esac
done

[[ $# -eq 1 ]] || { usage; exit 2; }

SRC="${1%/}"
[[ -e "$SRC" ]] || die "not found: $SRC"

case "$DEST" in
  cloud)        HOST="oldbook";   DIR="cloud" ;;
  oldbook)      HOST="oldbook";   DIR="incoming" ;;
  primebook)    HOST="primebook"; DIR="incoming" ;;
  morningbrief) HOST="primebook"; DIR="cloud/morningbrief" ;;
  *)            die "unknown destination: $DEST" ;;
esac

REMOTE="mikeb@$HOST:~/$DIR"
ARGS=(-avh --progress --partial)
[[ $DRY_RUN -eq 1 ]] && ARGS+=(-n --itemize-changes)
[[ $MOVE -eq 1 ]] && ARGS+=(--remove-source-files)

if [[ $DRY_RUN -eq 0 ]]; then
  ssh "mikeb@$HOST" "mkdir -p ~/$DIR" || die "mkdir failed"
fi

if [[ -d "$SRC" ]]; then
  printf 'Xeroxing %s/ -> %s/%s/\n' "$SRC" "$REMOTE" "${SRC##*/}" >&2
  rsync "${ARGS[@]}" "$SRC/" "$REMOTE/${SRC##*/}/" || die "rsync failed"
  if [[ $MOVE -eq 1 && $DRY_RUN -eq 0 ]]; then
    find "$SRC" -mindepth 1 -depth -type d -empty -delete
  fi
else
  printf 'Xeroxing %s -> %s/\n' "$SRC" "$REMOTE" >&2
  rsync "${ARGS[@]}" "$SRC" "$REMOTE/" || die "rsync failed"
fi
