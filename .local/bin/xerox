#!/usr/bin/env bash
set -euo pipefail

DEST_NAME="${XEROX_DEST:-prime}"
DEST_HOST="${XEROX_DEST_HOST:-}"
DEST_USER="${XEROX_DEST_USER:-mikeb}"
DEST_DIR="${XEROX_DEST_DIR:-}"
MOVE=0
DRY_RUN=0

usage() {
  cat >&2 <<'EOF_USAGE'
usage:
  xerox PATH
  xerox DEST PATH
  xerox --to DEST PATH
  xerox --move DEST PATH
  xerox --dry-run --move DEST PATH

destinations:
  prime      copies to mikeb@192.168.50.53:~/Documents/Primetv/
  oldcloud   copies to mikeb@192.168.50.53:~/oldcloud/

flags:
  --move, -m     remove source files after successful transfer
  --dry-run, -n  show what would happen

env overrides:
  XEROX_DEST, XEROX_DEST_HOST, XEROX_DEST_USER, XEROX_DEST_DIR
EOF_USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -m|--move)
      MOVE=1
      shift
      ;;
    -n|--dry-run)
      DRY_RUN=1
      shift
      ;;
    -t|--to)
      if [[ $# -lt 2 ]]; then
        usage
        exit 2
      fi
      DEST_NAME="$2"
      shift 2
      ;;
    --to=*)
      DEST_NAME="${1#--to=}"
      shift
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -eq 2 ]]; then
  DEST_NAME="$1"
  shift
elif [[ $# -ne 1 ]]; then
  usage
  exit 2
fi

case "$DEST_NAME" in
  prime|primetv)
    DEST_HOST="${DEST_HOST:-192.168.50.53}"
    DEST_DIR="${DEST_DIR:-Documents/Primetv}"
    ;;
  oldcloud|cloud|oc)
    DEST_HOST="${DEST_HOST:-192.168.50.53}"
    DEST_DIR="${DEST_DIR:-oldcloud}"
    ;;
  *)
    printf 'xerox: unknown destination: %s\n\n' "$DEST_NAME" >&2
    usage
    exit 2
    ;;
esac

src=${1%/}

if [[ ! -e "$src" ]]; then
  printf 'xerox: no such file or directory: %s\n' "$src" >&2
  exit 1
fi

name=$(basename "$src")
parent_dir=$(cd "$(dirname "$src")" && pwd -P)

ssh "$DEST_USER@$DEST_HOST" "mkdir -p ~/'$DEST_DIR'"

RSYNC_ARGS=(-avh --partial --partial-dir=.rsync-partial --info=progress2)

if [[ "$DRY_RUN" -eq 1 ]]; then
  RSYNC_ARGS+=(-n --itemize-changes)
fi

if [[ "$MOVE" -eq 1 ]]; then
  RSYNC_ARGS+=(--remove-source-files)
fi

if [[ -d "$src" ]]; then
  printf 'Xeroxing %s/%s -> %s@%s:~/%s/%s\n' \
    "$parent_dir" "$name" "$DEST_USER" "$DEST_HOST" "$DEST_DIR" "$name"

  rsync "${RSYNC_ARGS[@]}" \
    "$parent_dir/$name/" \
    "$DEST_USER@$DEST_HOST:~/$DEST_DIR/$name/"

  if [[ "$MOVE" -eq 1 && "$DRY_RUN" -eq 0 ]]; then
    find "$parent_dir/$name" -depth -type d -empty -delete
  fi
else
  printf 'Xeroxing %s/%s -> %s@%s:~/%s/%s\n' \
    "$parent_dir" "$name" "$DEST_USER" "$DEST_HOST" "$DEST_DIR" "$name"

  rsync "${RSYNC_ARGS[@]}" \
    "$parent_dir/$name" \
    "$DEST_USER@$DEST_HOST:~/$DEST_DIR/"
fi
