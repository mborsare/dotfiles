# Volume controls — macOS
ctrl - 0x1B : osascript -e 'set volume output volume ((output volume of (get volume settings)) - 5)'
ctrl - 0x18 : osascript -e 'set volume output volume ((output volume of (get volume settings)) + 5)'


# Window management — yabai
# Fast repeat; discard overlapping resize commands.
# Option + - : Shrink focused window
alt - 0x1B : lockf -s -k -t 0 "$HOME/.yabai-resize.lock" /bin/sh -c 'yabai -m window --resize right:-40:0 2>/dev/null || yabai -m window --resize left:40:0 2>/dev/null || yabai -m window --resize bottom:0:-40 2>/dev/null || yabai -m window --resize top:0:40 2>/dev/null'
# Option + = : Grow focused window
alt - 0x18 : lockf -s -k -t 0 "$HOME/.yabai-resize.lock" /bin/sh -c 'yabai -m window --resize right:40:0 2>/dev/null || yabai -m window --resize left:-40:0 2>/dev/null || yabai -m window --resize bottom:0:40 2>/dev/null || yabai -m window --resize top:0:-40 2>/dev/null'
alt - 0x18 : yabai -m window --resize right:40:0 || yabai -m window --resize left:-40:0 || yabai -m window --resize bottom:0:40 || yabai -m window --resize top:0:-40


